<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.opencds</groupId>
        <artifactId>opencds-parent</artifactId>
        <version>7.0.1</version>
    </parent>
    <artifactId>opencds-config</artifactId>
    <name>OpenCDS Parent for configuration classes</name>
    <packaging>pom</packaging>
    <modules>
        <module>opencds-config-api</module>
        <module>opencds-config-client</module>
        <module>opencds-config-file</module>
        <module>opencds-config-mappers</module>
        <module>opencds-config-rest</module>
        <module>opencds-config-schema</module>
        <module>opencds-config-service</module>
    </modules>
    <description>This module is a parent module for configuration modules:
        opencds-config-schema
    </description>
</project>
