<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>opencds-decision-support-rules</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.cdsframework</groupId>
        <artifactId>ice</artifactId>
        <version>1.0.0</version>
    </parent>

    <properties>
        <!-- Generated executable-model sources need no annotation processors; Lombok arrives transitively and would otherwise
             process every generated file. -->
        <maven.compiler.proc>none</maven.compiler.proc>
    </properties>

    <profiles>
        <profile>
            <id>compile-rules</id>
            <activation>
                <property>
                    <name>env.ICE_COMPILE_RULES</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>**/*.drl</exclude>
                            <exclude>**/*.dsl</exclude>
                            <exclude>**/*.dslr</exclude>
                        </excludes>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <groupId>org.kie</groupId>
                        <artifactId>kie-maven-plugin</artifactId>
                        <version>${kie-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>generate-model-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate-model-sources</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.drools</groupId>
            <artifactId>drools-model-compiler</artifactId>
            <version>${drools.version}</version>
        </dependency>

        <dependency>
            <groupId>org.cdsframework</groupId>
            <artifactId>opencds-decision-support-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

</project>