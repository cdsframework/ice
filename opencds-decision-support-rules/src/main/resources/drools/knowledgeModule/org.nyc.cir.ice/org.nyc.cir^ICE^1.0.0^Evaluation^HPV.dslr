rule "HPV: Evaluate the Absolute Minimum Interval in 2-Dose Series for Dose 2 - mark as Invalid if Interval < 5m-4 days from Dose 1"
    extends "HPV (Abstract): Intervals in 2-Dose Series for Dose 2 from Dose 1"
