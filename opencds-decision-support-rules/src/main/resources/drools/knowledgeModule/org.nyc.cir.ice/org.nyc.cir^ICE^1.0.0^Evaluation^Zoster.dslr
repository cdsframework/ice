package knowledgeModule.org.nyc.cir.ice;

import java.util.List;
import java.util.Set;
import org.opencds.vmr.v1_0.internal.EvalTime;
import org.opencds.vmr.v1_0.internal.EvaluatedPerson;
import org.cdsframework.ice.service.DiseaseImmunity;
import org.cdsframework.ice.service.DoseRule;
import org.cdsframework.ice.service.DoseStatus;
import org.cdsframework.ice.service.ICEFactTypeFinding;
import org.cdsframework.ice.service.ICELogicHelper;
import org.cdsframework.ice.service.RecommendationStatus;
import org.cdsframework.ice.service.SeriesRules;
import org.cdsframework.ice.supportingdatatmp.SupportedFactConcept;
import org.cdsframework.ice.service.TargetDose;
import org.cdsframework.ice.service.TargetSeries;
import org.cdsframework.ice.util.TimePeriod;
import org.cdsframework.ice.util.TimePeriod.DurationType;
import org.cdsframework.ice.service.Vaccine;

expander ../../knowledgeCommon/org.cdsframework.ice/org.cdsframework^ICE^1.0.0.dsl;

global java.time.LocalDate evalTime;

/**
 * If a patient is administered CVX 187 < 52 days after a previously administered CVX 121 or CVX 188, and the CVX 121 or CVX 188 was
 * administered on or before 11/17/2020,  evaluate the shot as Invalid/Below Minimum Interval
 * (Note that Recommended interval between CVX 121 or CVX 188 to CVX 187 is 56 days. This is the default as specified in the table
 * rule, so no rule needs to be written.)
 */
rule "Zoster: Evaluate CVX 187 as Invalid/Below Minimum Interval if administered CVX 187 < 52 days after CVX 121 or CVX 188"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "doseIntervalCheck"
	when
		There is an administered shot $currentShot that needs to be evaluated
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- the administered shot number is >= 2
			- the vaccine administered is "VACCINE_CVX_187"
			- make note of the administered shot number as $nAdministeredShotNumber
			- make note of the date this shot was administered as $currentShotDate
			- make note of the Associated Series as $associatedTargetSeries
		There is a Series $targetSeries identified by $associatedTargetSeries
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- the series is not complete
		There is an administered shot $priorShot
			- the shot belongs to the Series $associatedTargetSeries
			- the administered shot number is == $nAdministeredShotNumber-1
			- the vaccine administered a member of ("VACCINE_CVX_121","VACCINE_CVX_188")
			- the administration date of the shot is <= "17-Nov-2020"
			- make note of the date this shot was administered as $priorShotDate
		Confirm elapsed time between $priorShotDate and $currentShotDate < "52d"
	then
		Include the reason for shot $currentShot Invalid due to "Below Minimum Interval"
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end

/**
 * If a CVX 121 is evaluated as Invalid / VACCINE_NOT_ALLOWED, include supplemental text indicating that Zostavax is unavailable
 * in the United States.
 */
rule "Zoster: If CVX 121 has been evaluated as Invalid / VACCINE_NOT_ALLOWED, add supplemental text"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $currentShot
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- that has already been evaluated and whose shot validity status is INVALID
			- the vaccine administered is "VACCINE_CVX_121"
			- make note of all evaluation reasons for this shot as $collectionOfStrReasons
			- the collection $collectionOfStrReasons contains "EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED"
			- make note of the associated series as $associatedTargetSeries
	then
		Include Supplemental Text "SUPPLEMENTAL_EVALUATION_REASON_CONCEPT.ZOSTAVAX_UNAVAILABLE_US" for Invalid Shot $currentShot
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $associatedTargetSeries
end

rule "Zoster: Remove evaluation reason VACCINE_NOT_ALLOWED_FOR_THIS_DOSE when VACCINE_NOT_ALLOWED is also present"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	no-loop true
	when
		There is an administered shot $notAllowedShot
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- that has already been evaluated and whose shot validity status is INVALID
			- make note of all evaluation reasons for this shot as $collectionOfStrReasons
			- the collection $collectionOfStrReasons contains "EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED"
			- the collection $collectionOfStrReasons contains "EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED_FOR_THIS_DOSE"
			- make note of the associated series as $associatedTargetSeries
	then
		Remove Evaluation Reason "EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED_FOR_THIS_DOSE" from Shot $notAllowedShot
		Record that this dose rule was Processed for the TargetDose $notAllowedShot
		Log that this dose rule fired for the dose $notAllowedShot in the Series $associatedTargetSeries
end

/**
 * If a patient is administered CVX 121 or CVX 188 and it is not listed as a valid vaccine for that dose in the series,
 * evaluate the shot as Accepted/VACCINE_NOT_PART_OF_THIS_SERIES when it is invalid only due to
 * VACCINE_NOT_ALLOWED_FOR_THIS_DOSE and possibly BELOW_MINIMUM_AGE_VACCINE.
 */
rule "Zoster: Evaluate shot as Accepted/VACCINE_NOT_PART_OF_THIS_SERIES if administered CVX 121 or CVX 188 is not valid for that dose in the series"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $currentShot
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- the vaccine administered a member of ("VACCINE_CVX_121","VACCINE_CVX_188")
			- that has already been evaluated and whose shot validity is INVALID
			- make note of invalid evaluation reasons for this shot as $invalidEvaluationReasons
            - the collection $invalidEvaluationReasons contains "EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED_FOR_THIS_DOSE"
			- the invalid reasons are members of ("EVALUATION_REASON_CONCEPT.VACCINE_NOT_ALLOWED_FOR_THIS_DOSE", "EVALUATION_REASON_CONCEPT.BELOW_MINIMUM_AGE_VACCINE")
			- make note of the Associated Series as $associatedTargetSeries
			- make note of the Dose Number as $doseNumber
			- make note of the administered vaccine as $administeredVaccine
		There is a Series $targetSeries identified by $associatedTargetSeries
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.ZOSTER"
			- the series is not complete
	then
	    Set the shot status of $currentShot to Accepted
	    Remove all evaluation reasons from shot $currentShot
		Include the reason for shot $currentShot Accepted due to "Vaccine Not Part of This Series"
		Refresh all facts for the shot $currentShot
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end
