package knowledgeModule.org.nyc.cir.ice;

import java.util.Date;
import java.util.Iterator;
import java.util.List;
import java.util.Set;
import org.opencds.vmr.v1_0.internal.EvalTime;
import org.opencds.vmr.v1_0.internal.EvaluatedPerson;
import org.cdsframework.ice.service.DiseaseImmunity;
import org.cdsframework.ice.service.DoseStatus;
import org.cdsframework.ice.service.ICEFactTypeFinding;
import org.cdsframework.ice.service.ICELogicHelper;
import org.cdsframework.ice.service.Recommendation;
import org.cdsframework.ice.service.RecommendationStatus;
import org.cdsframework.ice.service.SeriesRules;
import org.cdsframework.ice.supportingdata.BaseDataEvaluationReason;
import org.cdsframework.ice.supportingdatatmp.SupportedFactConcept;
import org.cdsframework.ice.service.TargetDose;
import org.cdsframework.ice.service.TargetSeries;
import org.cdsframework.ice.util.TimePeriod;
import org.cdsframework.ice.util.TimePeriod.DurationType;
import org.cdsframework.ice.service.Vaccine;

expander ../../knowledgeCommon/org.cdsframework.ice/org.cdsframework^ICE^1.0.0.dsl;

global java.util.Date evalTime;

rule "Mpox: If the administered vaccine is not permitted by default for the series, and the series is not complete, evaluate it as ACCEPTED/VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "allowableVaccineCheck"
	when
		There is an administered shot $currentShot that needs to be evaluated
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.MPOX"
			- the series that the shot belongs to is not complete
			- make note of the administered vaccine as $vaccineAdministered
			- make note of the dose number as $doseNumber
			- make note of the associated series as $associatedTargetSeries
		There is a Series $targetSeries identified by $associatedTargetSeries
			- the vaccine $vaccineAdministered is not permitted for dose number $doseNumber in this series
	then
		Include the reason for shot $currentShot Accepted due to "Vaccine Not Counted Based on Most Recent Vaccine Given"
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end

/**
 * If the 2nd shot is administered below the minimum interval, evaluate the shot as Valid with reason code SUPPLEMENTAL_TEXT
 * and descriptive text: “The interval between this dose and the prior shot is less than the minimum interval. The dose does not
 * need to be repeated unless the patient is severely immunosuppressed, in which case the repeated dose should be administered after
 * the dose given in error by at least 28 days.
 */
 rule "Mpox: If the dose 2 of the 2-dose series is administered prior to 28 days, include supplemental text that the dose does not follow the guidelines for minimum intervals"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is a Series $targetSeries
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.MPOX"
			- the series is complete
			- the name of the Series is "SUPPORTED_SERIES.Mpox2DoseSeries"
			- the effective number of doses administered in the Series is == 2
		There is an administered shot $administeredShot
			- the shot belongs to the series $targetSeries
			- that has already been evaluated and whose Shot Validity Status is VALID
			- the dose number in the Series is == 2
			- make note of the date this shot was administered as $currentShotDate
		There does not exist an administered shot
			- the shot belongs to the series $targetSeries
			- that has already been evaluated
			- the administration date of the shot is > $currentShotDate
		There is an administered shot $priorShot
			- the shot belongs to the series $targetSeries
			- the administration date of the shot is < $currentShotDate
			- make note of the date this shot was administered as $priorShotDate
		There does not exist an administered shot
			- the shot belongs to the series $targetSeries
			- the administration date of the shot is > $priorShotDate
			- the administration date of the shot is < $currentShotDate
		Confirm elapsed time between $priorShotDate and $currentShotDate < "28d"
	then
		Include Supplemental Text "EVALUATION_REASON_CONCEPT.MPOX_MIN_INTERVAL_28D" for Valid Shot $administeredShot
		Record that this dose rule was Processed for the TargetDose $administeredShot
		Log that this dose rule fired for the dose $administeredShot in the Series $targetSeries
end

rule "Mpox: If a booster dose is administered, evaluate the shot as Valid"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "extraDoseCheck"
	when
		There is an administered shot $currentShot that needs to be evaluated
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.MPOX"
			- the Series that the shot belongs to is complete
			- the Series that the shot belongs to is complete
			- make note of the administered shot number as $currentShotNumber
			- make note of the associated series as $associatedTargetSeries
		There is a Series $targetSeries identified by $associatedTargetSeries
			- make note of the dose number after which the Series was marked complete as $doseNumberAfterWhichComplete
		There is an administered shot $previousDoseWhichCompletesSeries
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.MPOX"
			- the administered shot number is == $currentShotNumber-1
			- that has already been evaluated and whose shot validity is VALID
			- the dose number in the Series is == $doseNumberAfterWhichComplete
	then
		Set the Shot Status of $currentShot to Valid
		Remove evaluation reason "EVALUATION_REASON_CONCEPT.EXTRA_DOSE" from shot $currentShot
        Mark that evaluation of shot $currentShot is complete and therefore should not be reevaluated by any other rules
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end

rule "Mpox: If a shot, VACCINE_CVX_75 or VACCINE_CVX_105, is evaluated as Invalid due to being below the live virus interval, mark the shot Valid if first shot is VACCINE_CVX_206"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $administeredShot
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.MPOX"
			- that has already been evaluated and whose Shot Validity Status is INVALID
			- the administered shot number is == 2
			- make note of all evaluation reasons for this shot as $collectionOfStrReasons
			- the collection $collectionOfStrReasons contains "EVALUATION_REASON_CONCEPT.TOO_EARLY_LIVE_VIRUS"
			- the size of the collection $collectionOfStrReasons is == 1
			- make note of the Associated Series as $associatedTargetSeries
		There is an administered shot $previousShot
			- the Shot belongs to the series $associatedTargetSeries
			- that has already been evaluated and whose shot validity status is VALID
			- the vaccine administered is "VACCINE_CVX_206"
	then
		Set the shot status of $administeredShot to Valid
		Remove all evaluation reasons from shot $administeredShot
		Mark that evaluation of shot $administeredShot is complete and therefore should not be reevaluated by any other rules
		Record that this dose rule was Processed for the TargetDose $administeredShot
		Log that this dose rule fired for the dose $administeredShot in the Series $associatedTargetSeries
end

rule "Mpox: If additional shots are administered after booster shot, evaluated them as Accepted / EXTRA_DOSE"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $administeredShot
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.MPOX"
			- the series that the shot belongs to is Complete
			- the series that the shot belongs to is Complete
			- that has already been evaluated and whose Shot Validity Status is VALID
			- make note of the Associated Series as $associatedTargetSeries
			- make note of the administered shot number as $administeredShotNumber
		There is a Series $targetSeries identified by $associatedTargetSeries
			- make note of the dose number after which the Series was marked complete as $doseNumberAfterWhichComplete
			- the effective number of doses administered in the Series is > $doseNumberAfterWhichComplete+1
		Confirm that the following is true: $administeredShotNumber > $doseNumberAfterWhichComplete+1
	then
		Include the reason for shot $administeredShot Accepted due to "Extra Dose"
		Mark that evaluation of shot $administeredShot is complete and therefore should not be reevaluated by any other rules
		Record that this dose rule was processed for the TargetDose $administeredShot
		Log that this dose rule fired for the dose $administeredShot in the Series $associatedTargetSeries
end