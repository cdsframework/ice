rule "Polio: Booster Dose >=18 first booster dose is valid"
    dialect "mvel"
    ruleflow-group "HistoryEvaluation^customEvaluationRule"
    activation-group "extraDoseCheck"
    when
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The series is complete
            - Make note of the dose number after which the series was marked complete as $numberOfDosesRequired
        There is an administered shot $targetDose that needs to be evaluated
            - The shot belongs to the series $targetSeries
            - The dose number in the series is == $numberOfDosesRequired + 1
            - Make note of the date this shot was administered as $boosterAdministrationDate
        The patient information $patientInformation must be known to complete writing this rule
            - Make note of the date as $dateAtAge18y when the patient is "18y" of age
        Confirm the date $boosterAdministrationDate is on the same date or after $dateAtAge18y
    then
        Set the shot status of $targetDose to valid
        Include the reason for shot $targetDose valid due to "Booster Dose"
        Record that this dose rule was processed for the TargetDose $targetDose
        Log that this dose rule fired for the dose $targetDose in the Series $targetSeries
end

/**
 * If a patient receives CVX 178 or CVX 179, evaluate these shots as Invalid with reason code MISSING_ANTIGEN
 */
rule "Polio: Mark OPV shots (CVX 178 or CVX 179) as INVALID with reason MISSING_ANTIGEN and ignore the shot"
    ruleflow-group "HistoryEvaluation^customEvaluationRule"
    activation-group "allowableVaccineCheck"
    when
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The series is not complete
        There is an administered shot $currentShot that needs to be evaluated
            - The shot belongs to the series $targetSeries
            - The vaccine administered a member of ("VACCINE_CVX_178","VACCINE_CVX_179")
    then
        Include the reason for shot $currentShot invalid due to "Missing Antigen"
        Mark the shot $currentShot as ignored
        Record that this dose rule was processed for the TargetDose $currentShot
        Log that this dose rule fired for the dose $currentShot in the series $targetSeries
end

rule "Polio: Mark OPV shots (CVX 178 or CVX 179) as INVALID with reason MISSING_ANTIGEN and ignore the shot, but only for potential booster shots"
