package knowledgeModule.org.nyc.cir.ice;

import java.util.List;
import java.util.Set;
import org.opencds.vmr.v1_0.internal.EvalTime;
import org.opencds.vmr.v1_0.internal.EvaluatedPerson;
import org.cdsframework.ice.service.DiseaseImmunity;
import org.cdsframework.ice.service.DoseRule;
import org.cdsframework.ice.service.DoseStatus;
import org.cdsframework.ice.service.ICEFactTypeFinding;
import org.cdsframework.ice.service.ICELogicHelper;
import org.cdsframework.ice.service.Recommendation;
import org.cdsframework.ice.service.RecommendationStatus;
import org.cdsframework.ice.service.SeriesRules;
import org.cdsframework.ice.supportingdatatmp.SupportedFactConcept;
import org.cdsframework.ice.service.TargetDose;
import org.cdsframework.ice.service.TargetSeries;
import org.cdsframework.ice.util.TimePeriod;
import org.cdsframework.ice.util.TimePeriod.DurationType;
import org.cdsframework.ice.service.Vaccine;

expander ../../knowledgeCommon/org.cdsframework.ice/org.cdsframework^ICE^1.0.0.dsl;

global java.util.Date evalTime;

/**
 * Series complete with 3 doses if dose 3 was administered when the patient was >= 4 years - 4 days and was administered at least 6 months -
 * 4 days after the previous dose, then the series is complete with 3 doses.
 */
rule "Polio: (Series Complete with 3 Doses Rule 2)- Series is Complete if 3 prior doses, patient >= 4yrs-4d when dose 3 administered, and dose 3 >= 6m-4d after previous dose"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $dose3
			- The shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- That has already been evaluated and whose shot validity is VALID
			- The dose number in the series is == 3
			- Make note of the date this shot was administered as $administrationDate
			- Make note of the associated series as $associatedTargetSeries
		There is an Administered Shot $prevdose2
			- The shot belongs to the series $associatedTargetSeries
			- That has already been evaluated and whose shot validity is VALID
			- The dose number in the series is == 2
			- Make note of the date this shot was administered as $administrationDatePrev
		There is a series $targetSeries identified by $associatedTargetSeries
			- The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The series is not complete
			- The number of doses administered is == 3
		The patient information $patientInformation must be known to complete writing this rule
			- Make note of the patient's birthdate as $birthDate
		Confirm elapsed time between $birthDate and $administrationDate >= "4y-4d" && elapsed time between $administrationDatePrev and $administrationDate >= "6m-4d"
	then
		Mark the series $targetSeries complete
		Refresh all facts in the series $targetSeries for Evaluation
		Record that this series rule was Processed for the TargetSeries $targetSeries
		Log that this series rule fired for the Series $targetSeries
end

rule "Polio: Modify DoseRule4 Absolute minimum age and Absolute Minimum Interval parameters for target dose 4 if administered before 8/7/2009"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	no-loop true
	when
		There is an Administered Shot $currentDose that needs to be evaluated
			- The shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO" and the series with name "SUPPORTED_SERIES.Polio4DoseSeries"
			- The dose number in the series is == 4
			- The administration date of the shot is < "07-Aug-2009"
			- Make note of the date this shot was administered as $administrationDateCurrentDose
			- Make note of the associated series as $associatedTargetSeries
	then
		Obtain the existing DoseRule for Dose Number 4 in the Series $associatedTargetSeries as $assign_oDoseRule4
		Set the Absolute Minimum Age for DoseRule $assign_oDoseRule4 to TimePeriod "122d"
		Replace the existing DoseRule in the Series $associatedTargetSeries with $assign_oDoseRule4
		Obtain the existing DoseRule for Dose Number 3 in the Series $associatedTargetSeries as $assign_oDoseRule3
		Set the Absolute Minimum Interval for DoseRule $assign_oDoseRule3 to TimePeriod "24d"
		Replace the existing DoseRule in the Series $associatedTargetSeries with $assign_oDoseRule3
		Refresh all facts in the series $associatedTargetSeries for Evaluation
		Record that this series rule was processed for the TargetSeries $associatedTargetSeries
		Log that this series rule fired for the Series $associatedTargetSeries
end

/**
 * For children who received target dose 4 at >= 8/7/2009 and before 4 years - 4 days of age, evaluate target dose 4 as Accepted/
 * BELOW_MINIMUM_AGE_FINAL_DOSE (if absolute minimum interval is met). (An additional dose will be recommended at >= 4 years of age).
 */
rule "Polio: Mark target dose 4 administered >= 8/7/2009 and before absolute minimum age as ACCEPTED with reason BELOW_MINIMUM_AGE_FINAL_DOSE"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "doseAgeCheck"
	when
	    There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The name of the series is "SUPPORTED_SERIES.Polio4DoseSeries"
            - Make note of the absolute minimum age for dose 4 in this series as $absoluteMinimumAge
	    There is an administered shot $dose3
	        - The shot belongs to the series $targetSeries
		    - The dose number in the series is == 3
		    - Make note of the date this shot was administered as $dose3AdminDate
		    - Make note of the absolute minimum interval from this dose to the next dose as $dose3To4MinimumInterval
		There is an administered shot $targetDose4 that needs to be evaluated
			- The shot belongs to the series $targetSeries
			- The dose number in the series is == 4
			- The administration date of the shot is >= "07-Aug-2009"
			- Make note of the date this shot was administered as $dose4AdminDate
			- Make note of the associated series as $associatedTargetSeries
		The patient information $patientInformation must be known to complete writing this rule
			- Make note of the patient's birthdate as $birthDate
		Confirm elapsed time between $birthDate and $dose4AdminDate < $absoluteMinimumAge
		Confirm elapsed time between $dose3AdminDate and $dose4AdminDate >= $dose3To4MinimumInterval
	then
		Include the reason for shot $targetDose4 accepted due to "Below Minimum Age for Final Dose"
		Record that this dose rule was processed for the TargetDose $targetDose4
		Log that this dose rule fired for the dose $targetDose4 in the Series $targetSeries
end

rule "Polio: Booster Dose >=18 first booster dose is valid"
    dialect "mvel"
    ruleflow-group "HistoryEvaluation^customEvaluationRule"
    activation-group "extraDoseCheck"
    when
        The patient information $patientInformation must be known to complete writing this rule
            - Make note of the date as $dateAtAge18y when the patient is "18y" of age
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The name of the series is "SUPPORTED_SERIES.Polio4DoseSeries"
            - The series is complete
			- Make note of the dose number after which the series was marked complete as $numberOfDosesRequired
        There is an administered shot $targetDose that needs to be evaluated
            - The shot belongs to the series $targetSeries
            - The dose number in the series is == $numberOfDosesRequired + 1
            - Make note of the date this shot was administered as $boosterAdministrationDate
        Confirm the date $boosterAdministrationDate is on the same date or after $dateAtAge18y
    then
        Set the shot status of $targetDose to valid
		Include the reason for shot $targetDose valid due to "Booster Dose"
		Record that this dose rule was processed for the TargetDose $targetDose
		Log that this dose rule fired for the dose $targetDose in the Series $targetSeries
end

/**
 * If a patient receives CVX 178 or CVX 179, evaluate these shots as Invalid with reason code MISSING_ANTIGEN
 */
rule "Polio: Mark OPV shots (CVX 178 or CVX 179) as INVALID with reason MISSING_ANTIGEN"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "allowableVaccineCheck"
	when
		There is an Administered Shot $currentShot that needs to be evaluated
			- The shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The vaccine administered a member of ("VACCINE_CVX_178","VACCINE_CVX_179")
			- Make note of the associated series as $associatedTargetSeries
		There is a Series $targetSeries identified by $associatedTargetSeries
			- The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The series is not complete
	then
		Include the reason for shot $currentShot Invalid due to "Missing Antigen"
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end

/**
 * If a patient receives shots of OPV administered >= 4/1/2016, these shots do not count towards the series. Evaluate these shots as
 * Invalid with reason code MISSING_ANTIGEN
 */
rule "Polio: Mark OPV shots administered >= 4/1/2016 as INVALID with reason MISSING_ANTIGEN"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	when
		There is an Administered Shot $currentShot that needs to be evaluated
			- The shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The administration date of the shot is >= "01-Apr-2016"
			- The vaccine administered a member of ("VACCINE_CVX_02","VACCINE_CVX_178","VACCINE_CVX_179","VACCINE_CVX_182")
			- Make note of the associated series as $associatedTargetSeries
		There is a series $targetSeries identified by $associatedTargetSeries
			- The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The series is not complete
	then
		Include the reason for shot $currentShot Invalid due to "Missing Antigen"
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $targetSeries
end

/**
* If CVX 89 was administered >= 4/1/2016, return reason code SUPPLEMENTAL_TEXT and descriptive text: “CVX 89 represents an
* unspecified formulation vaccine. Trivalent oral polio vaccine ceased to be used globally in April 2016. If the patient received
* bivalent or monovalent oral polio vaccine (bOPV or mOPV), additional protection is needed."
*/
rule "Polio: CVX 89 shots administered >= 4/1/2016"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $currentShot
			- The shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
			- The administration date of the shot is >= "01-Apr-2016"
			- The vaccine administered is "VACCINE_CVX_89"
			- Make note of the associated series as $associatedTargetSeries
		There is a series $targetSeries identified by $associatedTargetSeries
			- The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
	then
        Include supplemental text "EVALUATION_REASON_CONCEPT.POLIO_CVX_89" for invalid shot $currentShot
		Include supplemental text "EVALUATION_REASON_CONCEPT.POLIO_CVX_89" for valid shot $currentShot
		Record that this dose rule was processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $associatedTargetSeries
end
