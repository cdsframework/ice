rule "Polio: CVX 324 not valid in Polio4Dose Series"
    ruleflow-group "HistoryEvaluation^customEvaluationRule"
    activation-group "allowableVaccineCheck"
    when
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The name of the series is "SUPPORTED_SERIES.POLIO_4_DOSE_SERIES"
        There is an administered shot $currentShot that needs to be evaluated
            - The shot belongs to the series $targetSeries
            - The vaccine administered is "VACCINE_CVX_324"
    then
        Include the reason for shot $currentShot Invalid due to "Vaccine Not Part of This Series"
        Record that this dose rule was processed for the TargetDose $currentShot
        Log that this dose rule fired for the dose $currentShot in the series $targetSeries
end

/**
* If CVX 89 was administered >= 4/1/2016, return reason code SUPPLEMENTAL_TEXT and descriptive text: “CVX 89 represents an
* unspecified formulation vaccine. Trivalent oral polio vaccine ceased to be used globally in April 2016. If the patient received
* bivalent or monovalent oral polio vaccine (bOPV or mOPV), additional protection is needed."
*/
rule "Polio: CVX 89 shots administered >= 4/1/2016"
    ruleflow-group "HistoryEvaluation^postEvaluationCheck"
    when
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
        There is an administered shot $currentShot
            - The shot belongs to the series $targetSeries
            - The vaccine administered is "VACCINE_CVX_89"
            - The administration date of the shot is >= "01-Apr-2016"
    then
        Include supplemental text "SUPPLEMENTAL_EVALUATION_REASON_CONCEPT.POLIO_CVX_89" for invalid shot $currentShot
        Include supplemental text "SUPPLEMENTAL_EVALUATION_REASON_CONCEPT.POLIO_CVX_89" for valid shot $currentShot
        Include supplemental text "SUPPLEMENTAL_EVALUATION_REASON_CONCEPT.POLIO_CVX_89" for accepted shot $currentShot
        Record that this dose rule was processed for the TargetDose $currentShot
        Log that this dose rule fired for the dose $currentShot in the series $targetSeries
end

/**
* Series complete with 4 doses
* For children who received target dose 4 at >= 8/7/2009 and before 4 years - 4 days of age: An additional dose (target dose 5) is needed to complete the series
**/
rule "Polio: Polio4DoseSeries - Series complete with 4 doses if target dose 4 received < 8/7/2009 or after 4 years - 4 days of age"
    dialect "mvel"
    ruleflow-group "HistoryEvaluation^postEvaluationCheck"
    when
        There is a series $targetSeries
            - The series belongs to the vaccine group "VACCINE_GROUP_CONCEPT.POLIO"
            - The name of the series is "SUPPORTED_SERIES.POLIO_4_DOSE_SERIES"
            - The series is not complete
        There is an administered shot $dose4
            - The shot belongs to the series $targetSeries
            - The dose number in the series is == 4
            - That has already been evaluated and whose shot validity is VALID
            - Make note of the date this shot was administered as $dose4AdminDate
        The patient information $patientInformation must be known to complete writing this rule
            - Make note of the date as $cutoffDate when the patient is "4y-4d" of age
        Confirm !(the date $dose4AdminDate is on the same date or after "07-Aug-2009" && the date $dose4AdminDate is before $cutoffDate)
    then
        Mark the series $targetSeries complete

        Record that this series rule was processed for the TargetSeries $targetSeries
        Log that this series rule fired for the series $targetSeries
end

/**
* Series complete with 5 doses
* For children who received target dose 5 at >= 8/7/2009 and before 4 years - 4 days of age: An additional dose (target dose 6) is needed to complete the series
**/
rule "Polio: PoliofIPVSeries - Series complete with 6 doses if target dose 5 received < 8/7/2009 or after 4 years - 4 days of age"
