global java.time.LocalDate evalTime;
global org.cdsframework.ice.service.Schedule schedule;

/**
 * Specialized initialization rule for Meningococcal ACWY and Meningococcal B vaccine group
 * This catchall rule should not fire, because all vaccines should either be explicitly placed into the Meningococcal ACWY or
 * Meningococcal B vaccine group per other rules (below). But if it does fire, it will be placed into the vaccine group if it has at
 * least one series that accepts that vaccine. This is actually more restrictive than the default cdsframework rule, which will
 * initialize a TargetDose into a TargetSeries is both target the same disease (as specified by the disease code)
 */
rule "CandidateDosesIdentification: Initialize TargetDose in Meningococcal ACWY or Meningococcal B Vaccine Group Series"
	dialect "java"
	ruleflow-group "CandidateDosesIdentification^customCandidateDosesIdentificationRule"
	salience 55
	no-loop true
	when
		$i : ImmunizationConcept($ctid : getConceptTargetId(), $occ : getOpenCdsConceptCode(), $occ not in ("VACCINE_CVX_316", "VACCINE_CVX_328"))
		$sae : SubstanceAdministrationEvent(id == $ctid)
		$s : SeriesRules($sseriesName : getSeriesName(), $vg : getVaccineGroup(), getVaccineGroup() == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_ACWY" || getVaccineGroup() == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B",
			vaccineIsAllowableInOneOrMoreDoseRules(schedule.getVaccineByCdsConceptValue($i.getOpenCdsConceptCode())))
		$ts : TargetSeries(seriesName == $sseriesName, $tsid : targetSeriesIdentifier)
		$tdit : TargetDoseInitializationTracker(shotAdministeredIsEligibleForInclusionInTargetSeries($i, $vg, $sae, $ts, schedule.getVaccineByCdsConceptValue($occ)) == true)
	then
		Vaccine administeredVaccine = schedule.getVaccineByCdsConceptValue($i.getOpenCdsConceptCode());
		for (TargetDose initializedTargetDose : $tdit.addTargetDoseInitialization(administeredVaccine, $sae, $ts, schedule)) {
			insert(initializedTargetDose);
		}
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "completed");
end

/**
 * Meningococcal B vaccines (CVX 162, 163) always initializes the Meningococcal B vaccine group
 */
rule "CandidateDosesIdentification: Initialize Meningococcal B vaccines (CVX 162, 163, 164) in the Meningococcal B vaccine group"
	dialect "java"
	ruleflow-group "CandidateDosesIdentification^customCandidateDosesIdentificationRule"
	salience 60
	no-loop true
	when
		$i : ImmunizationConcept(
                $ctid : getConceptTargetId(),
                $occ : getOpenCdsConceptCode(),
                $occ in ("VACCINE_CVX_162", "VACCINE_CVX_163", "VACCINE_CVX_164")
             )
		$sae : SubstanceAdministrationEvent(
		        id == $ctid,
		        $saeAdminDate : getAdministrationTimeInterval()
		       )
		$s : SeriesRules(
		        $sseriesName : getSeriesName(),
		        $vg : getVaccineGroup(),
		        getVaccineGroup() == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B",
		        vaccineIsAllowableInOneOrMoreDoseRules(schedule.getVaccineByCdsConceptValue($i.getOpenCdsConceptCode()))
		     )
		$ts : TargetSeries(
		        seriesName == $sseriesName,
		        $tsid : targetSeriesIdentifier
		      )
		$tdit : TargetDoseInitializationTracker(shotAdministeredIsEligibleForInclusionInTargetSeries($i, $vg, $sae, $ts, schedule.getVaccineByCdsConceptValue($occ)) == true)
	then
		Vaccine administeredVaccine = schedule.getVaccineByCdsConceptValue($i.getOpenCdsConceptCode());
		for (TargetDose initializedTargetDose : $tdit.addTargetDoseInitialization(administeredVaccine, $sae, $ts, schedule)) {
			insert(initializedTargetDose);
		}
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetDose initialized in TargetSeries " + $ts.getSeriesName() + " ; vaccine: " + $occ + "; vaccine group " + $vg + "; shotdate " + $saeAdminDate);
end

/**
 * Meningococcal MenABCWY-TT (Penbraya) (CVX 316) initialization in Meningococcal B vaccine group
 */
rule "CandidateDosesIdentification: Initialize Meningococcal vaccine (CVX 316) in the Meningococcal B vaccine group"
	dialect "java"
	ruleflow-group "CandidateDosesIdentification^customCandidateDosesIdentificationRule"
	salience 60
	no-loop true
	when
		$i : ImmunizationConcept($ctid : getConceptTargetId(), getOpenCdsConceptCode() == "VACCINE_CVX_316", $occ : getOpenCdsConceptCode())
		$sae : SubstanceAdministrationEvent(id == $ctid, $saeAdminDate : getAdministrationTimeInterval())
		$s : SeriesRules($sseriesName : getSeriesName(), $vg : getVaccineGroup(), getVaccineGroup() == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B")
		$ts : TargetSeries(seriesName == $sseriesName, $tsid : targetSeriesIdentifier)
		$tdit : TargetDoseInitializationTracker(shotAdministeredIsEligibleForInclusionInTargetSeries($i, $vg, $sae, $ts, schedule.getVaccineByCdsConceptValue($occ)) == true)
		eval($tdit.isTargetDoseInitializedInSeries($sae, new VaccineComponent(new CdsConcept("VACCINE_CVX_162"), schedule.getDiseasesTargetedByVaccineGroup("VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B")), $ts) == false)

	then
		Vaccine administeredVaccine = schedule.getVaccineByCdsConceptValue($i.getOpenCdsConceptCode());
		VaccineComponent vaccineComponentOfInterest = new VaccineComponent(new CdsConcept("VACCINE_CVX_162"), schedule.getDiseasesTargetedByVaccineGroup("VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B"));
		for (TargetDose initializedTargetDose : $tdit.addTargetDoseInitialization(administeredVaccine, $sae, $ts, schedule, vaccineComponentOfInterest)) {
			insert(initializedTargetDose);
		}
		update($ts);
		update($tdit);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetDose initialized in TargetSeries " + $ts.getSeriesName() + " ; vaccine: " + $occ + "; vaccine group " + $vg + "; shotdate " + $saeAdminDate);
end

