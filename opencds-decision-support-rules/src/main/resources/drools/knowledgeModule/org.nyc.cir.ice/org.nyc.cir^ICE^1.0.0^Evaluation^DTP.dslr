rule "DTP: Do not run the default Extra_Dose series rule, which would mark this Adolescent Tdap Shot >= 10 yrs as an Extra Dose"
	extends "DTP: Evaluate Adolescent Tdap Shot based on Age >= 10yrs"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "extraDoseCheck"
