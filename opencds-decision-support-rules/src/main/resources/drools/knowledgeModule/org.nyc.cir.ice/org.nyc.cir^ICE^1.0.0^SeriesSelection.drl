		$td : TargetDose(associatedTargetSeries == $ts2doseSeries, vaccineComponent.cdsConceptName in ("VACCINE_CVX_162", "VACCINE_CVX_316"))
		not TargetDose(associatedTargetSeries == $td.associatedTargetSeries, administrationDate > $td.administrationDate)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName not in ("VACCINE_CVX_162", "VACCINE_CVX_316"), administrationDate > $td.administrationDate, isValid == true)
		eval($ts2doseSeries.determineNumberOfDosesAdministeredInSeries() == 1 && $ts3doseSeries.determineNumberOfDosesAdministeredInSeries() == 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
end

