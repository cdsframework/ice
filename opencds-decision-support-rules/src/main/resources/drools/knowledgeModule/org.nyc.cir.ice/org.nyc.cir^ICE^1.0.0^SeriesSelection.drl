	salience 10
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == false)
		not TargetSeries(this != $ts2doseSeries, seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
		$ts2doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts2doseSeries);
end

/**
 * Sub-bullet 2:
 *   If dose 1 is CVX 162 (Meningococcal B FHbp, recombinant (Trumenba)) and target dose 2 is CVX 162 (Meningococcal B FHbp,
 *   recombinant (Trumenba)) and invalid for the MenB FHbp 2-dose series, but valid for MenB FHbp 3-dose series, the MenB FHbp
 *   3-dose series applies.
 */
rule "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 3-dose series if dose 1 is (CVX 162, CVX 316) and target dose 2 (CVX 162, CVX 316) is Invalid for FHbp 2-dose series but Valid for FHbp 3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		exists ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Select MenB FHbp Series")
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts2doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp2DoseSeries")
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp3DoseSeries")
		eval($ts2doseSeries.determineNumberOfDosesAdministeredInSeries() <= 1 && $ts3doseSeries.determineNumberOfDosesAdministeredInSeries() >= 2)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts3doseSeries);
end

rule "SerieSelection(MenB): Select MenB FHbp 3-dose series if dose 1 is (CVX 162, CVX 316); target dose 2 (CVX 162, CVX 316) is Invalid for FHbp 2-dose series, Valid for FHbp 3-dose series; FHBp 3-dose series _is_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 3-dose series if dose 1 is (CVX 162, CVX 316) and target dose 2 (CVX 162, CVX 316) is Invalid for FHbp 2-dose series but Valid for FHbp 3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts3doseSeries);
end

rule "SerieSelection(MenB): Select MenB FHbp 3-dose series if dose 1 is CVX 162; target dose 2 (CVX 162, CVX 316) is Invalid for FHbp 2-dose series, Valid for FHbp 3-dose series; FHbp 3-dose series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 3-dose series if dose 1 is (CVX 162, CVX 316) and target dose 2 (CVX 162, CVX 316) is Invalid for FHbp 2-dose series but Valid for FHbp 3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == false)
		not TargetSeries(this != $ts3doseSeries, seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts3doseSeries);
end

/**
 * Sub-bullet 3:
 *   If dose 1 is CVX 162 (Meningococcal B FHbp, recombinant (Trumenba)) and target dose 2 is CVX 162 (Meningococcal B FHbp,
 *   recombinant (Trumenba)) and invalid for BOTH the MenB FHbp 2-dose series and MenB FHbp 3-dose series, the MenB FHbp 2-dose
 *   series applies. Neither series will be complete
 */
rule "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-dose series if dose 1 is (CVX 162, CVX 316), target dose 2 (CVX 162, CVX 316) is Invalid in both FHbp 2-dose series/3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		exists ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Select MenB FHbp Series")
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts2doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp2DoseSeries")
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp3DoseSeries")
		eval($ts2doseSeries.determineNumberOfDosesAdministeredInSeries() == 1 && $ts3doseSeries.determineNumberOfDosesAdministeredInSeries() == 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts2doseSeries);
end

/**
 * This should not happen based on current rules - 2-dose series is not complete until 2-doses have been administered
 */
rule "SeriesSelection(MenB): Select MenB FHbp 2-dose series if dose 1 is (CVX 162, CVX 316), target dose 2 (CVX 162) is Invalid in both MenB FHbp 2-dose series/3-dose series but series is complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-dose series if dose 1 is (CVX 162, CVX 316), target dose 2 (CVX 162, CVX 316) is Invalid in both FHbp 2-dose series/3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
		$ts2doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts2doseSeries);
end

rule "SeriesSelection(MenB): Select MenB FHbp 2-dose series if dose 1 is (CVX 162, CVX 316), target dose 2 (CVX 162, CVX 316) is Invalid in both MenB FHbp 2-dose series/3-dose series, series is not complete, and there are no other series complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-dose series if dose 1 is (CVX 162, CVX 316), target dose 2 (CVX 162, CVX 316) is Invalid in both FHbp 2-dose series/3-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == false)
		not TargetSeries(this != $ts2doseSeries, seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
		$ts2doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts2doseSeries);
end

/**
 * Sub-bullet 0a:
 *   If all shots are CVX 162, then either the MeB FHbp 2-Dose Series or MenB FHbp 3-Dose Series applies
 */
rule "SeriesSelection(MenB): Select MenB FHbp 2-Dose Series _or_ FHbp 3-Dose Series if all shots administered are CVX 162"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		not ICEFactTypeFinding(iceResultFinding in ("SeriesSelection: Select MenB 4C Series", "SeriesSelection: Select MenB FHbp Series"))
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName in ("VACCINE_CVX_162"))
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_163")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetSeries MenB4FHbpDoseSeries or TargetSeries MenFHbp3DoseSeries");
		insert(new ICEFactTypeFinding("SeriesSelection: Select MenB FHbp Series"));
end

/**
 * Sub-bullet 0b:
 *   If all shots are CVX 163, then either the MeB 4C 2-Dose Series or MenB 4C 3-Dose Series applies
 */
rule "SeriesSelection(MenB): Select MenB 4C 2-Dose Series _or_ 4C 3-Dose Series if all shots administered are CVX 163"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		not ICEFactTypeFinding(iceResultFinding in ("SeriesSelection: Select MenB 4C Series", "SeriesSelection: Select MenB FHbp Series"))
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName in ("VACCINE_CVX_163"))
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_162")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetSeries MenB4C2DoseSeries or TargetSeries Men4C3DoseSeries");
		insert(new ICEFactTypeFinding("SeriesSelection: Select MenB 4C Series"));
end

/**
 * Sub-bullet 1:
 *   If CVX 163 (Meningococcal B 4C, OMV (Bexsero)) is the last shot administered on the patient record, then the MenB 4C 2-dose
 *   series ---> NEW: or MenB 3-dose series applies.
 */
rule "ABSTRACT SeriesSelection(MenB): Select MenB 4C 2-Dose Series _or_ MenB 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 163"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		not ICEFactTypeFinding(iceResultFinding in ("SeriesSelection: Select MenB 4C Series", "SeriesSelection: Select MenB FHbp Series"))
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_162")
		$latestTd : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_163", associatedTargetSeries.seriesName in ("SUPPORTED_SERIES.MenB4C2DoseSeries", "SUPPORTED_SERIES.MenB4C3DoseSeries"),
			invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_163", associatedTargetSeries.seriesName in ("SUPPORTED_SERIES.MenB4C2DoseSeries", "SUPPORTED_SERIES.MenB4C3DoseSeries"), administrationDate > $latestTd.administrationDate,
			invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", administrationDate > $latestTd.administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_162", invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		$ts2doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries")
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C3DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries MenB4C2DoseSeries or TargetSeries MenB4C3DoseSeries");
		insert(new ICEFactTypeFinding("SeriesSelection: Select MenB 4C Series"));
end

rule "SeriesSelection(MenB): Select MenB 4C 2-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, last shot administered is CVX 163, Series is complete, and 4C 3-Dose Series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB 4C 2-Dose Series _or_ MenB 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 163"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == true)
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
		$ts2doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts2doseSeries);
end

rule "SeriesSelection(MenB): Select MenB 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, last shot administered is CVX 163, Series is complete, and 4C 2-Dose Series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB 4C 2-Dose Series _or_ MenB 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 163"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == false)
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts3doseSeries);
end

rule "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-Dose Series _or_ FHbp 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 162"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		not ICEFactTypeFinding(iceResultFinding in ("SeriesSelection: Select MenB 4C Series", "SeriesSelection: Select MenB FHbp Series"))
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_163")
		$latestTd : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName == "VACCINE_CVX_162", associatedTargetSeries.seriesName in ("SUPPORTED_SERIES.MenBFHbp2DoseSeries", "SUPPORTED_SERIES.MenBFHbp3DoseSeries"),
			invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", associatedTargetSeries.seriesName in ("SUPPORTED_SERIES.MenBFHbp2DoseSeries", "SUPPORTED_SERIES.MenBFHbp3DoseSeries"), administrationDate > $latestTd.administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_162",
			invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", administrationDate > $latestTd.administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_163", invalidReasons not contains BaseDataEvaluationReason._DUPLICATE_SAME_DAY_REASON.cdsListItemName)
		$ts2doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp2DoseSeries")
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp3DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries MenB4C2DoseSeries or TargetSeries MenB4C3DoseSeries");
		insert(new ICEFactTypeFinding("SeriesSelection: Select MenB FHbp Series"));
end

rule "SeriesSelection(MenB): Select MenB FHbp 2-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, last shot administered is CVX 162, Series is complete, and FHbp 3-Dose Series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-Dose Series _or_ FHbp 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 162"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == true)
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2doseSeries);
		$ts2doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts2doseSeries);
end

rule "SeriesSelection(MenB): Select MenB 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, last shot administered is CVX 163, Series is complete, and FHbp 2-Dose Series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB FHbp 2-Dose Series _or_ FHbp 4C 3-Dose Series if both (CVX 162, CVX 316) and CVX 163 present, and latest shot date administered is CVX 162"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		TargetSeries(this == $ts2doseSeries, isSeriesComplete() == false)
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts3doseSeries);
end

/**
 * If both CVX 162 (Meningococcal B FHbp, recombinant (Trumenba)) and CVX 163 (Meningococcal B 4C, OMV (Bexsero)) are on the patient
 * record, and one or more Series is complete, then select the Series of all of them that finished first.
 */
rule "SeriesSelection(MenB): If one or more Series is complete, select the Series that completed first (and did not complete on the same day)"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 40
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		and
		$tslatestcomplete : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
		and
		$tdlatestcomplete : TargetDose(associatedTargetSeries == $tslatestcomplete, isValid == true)
		and
		not TargetDose(associatedTargetSeries == $tslatestcomplete, administrationDate > $tdlatestcomplete.administrationDate, isValid == true)
		and
		(
			not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", this != $tslatestcomplete, isSeriesComplete() == true)
			or
			$tsothercomplete : TargetSeries(this != $tslatestcomplete, vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
			and
			$tdothercomplete : TargetDose(associatedTargetSeries == $tsothercomplete, isValid == true)
			and
			not TargetDose(associatedTargetSeries == $tsothercomplete, isValid == true, administrationDate > $tdothercomplete.administrationDate)
			and
			eval($tdlatestcomplete.administrationDate > $tdothercomplete.administrationDate)
		)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tslatestcomplete);
		$tslatestcomplete.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tslatestcomplete.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($tslatestcomplete);
end

/**
 * Hib: If the Series that was selected is Not Complete but the other Series is Complete, select the other (completed) Series
 * instead
 */
rule "SeriesSelection(Hib): If the Series that was selected is Not Complete but the other Series is Complete, select the other (completed) Series instead"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		$tsNotSelected : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", selectedSeries == false, isSeriesComplete() == true)
		$tsSelected : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", targetSeriesIdentifier != $tsNotSelected.targetSeriesIdentifier, selectedSeries == true, isSeriesComplete() == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection(Hib) change to *completed* TargetSeries " + $tsNotSelected);
		$tsSelected.setSelectedSeries(false);
		$tsNotSelected.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsNotSelected.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tsNotSelected);
		update($tsSelected);
		update($tss);
end

rule "SeriesSelection.SelectByDefaultHib4DoseSeries"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	activation-group "HibSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesRules.seriesName == "SUPPORTED_SERIES.Hib4DoseSeries",	selectedSeries == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		update($ts);
end

rule "SeriesSelection.SelectHibOMPSeriesIfFirstDoseHibOMPBefore7MonthsAndOnlyOneValidDoseTotal"
	dialect "java"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 200
	activation-group "HibSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", selectedSeries == true)
		$td : TargetDose(doseNumberInSeries == 1, isValid == true, $administrationDate : administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_49", $td1UniqueId : uniqueId)
		$ts: TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", $sn : seriesRules.seriesName == "SUPPORTED_SERIES.HibOMPSeries", selectedSeries == false,
			containsTargetDose($td), $effectiveDoses : determineEffectiveNumberOfDosesInSeries, numberOfShotsAdministeredInSeries == 1)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesRules.seriesName != $sn, $validShotByDoseNumber : getValidShotByDoseNumber(1), $validShotByDoseNumber != null, $validShotByDoseNumber.getAdministrationDate() < $administrationDate)
		$person : EvaluatedPerson($birthDate : demographics.birthTime)
		eval($effectiveDoses == 1 && TimePeriod.calculateElapsedTimePeriod($birthDate, $administrationDate, DurationType.MONTHS).isLessThan(new TimePeriod(7, DurationType.MONTHS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts.getSeriesName());
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.getSeriesName());
		update($ts);
end

rule "SeriesSelection.SelectHibOMPSeriesIfTwoDosesHibOMPOneBefore7MonthsOtherBefore12Months"
	dialect "java"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 300
	activation-group "HibSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", selectedSeries == true)
		$td1 : TargetDose(doseNumberInSeries == 1, isValid == true, $administrationDate1 : administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_49")
		$td2 : TargetDose(doseNumberInSeries == 2, isValid == true, $administrationDate2 : administrationDate, vaccineComponent.cdsConceptName == "VACCINE_CVX_49", $td2UniqueId : uniqueId)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", $sn : seriesRules.seriesName == "SUPPORTED_SERIES.HibOMPSeries",	selectedSeries == false, containsTargetDose($td1), containsTargetDose($td2))
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HIB", seriesRules.seriesName != $sn, $validShotByDoseNumber : getValidShotByDoseNumber(2), $validShotByDoseNumber != null, $validShotByDoseNumber.getAdministrationDate() < $administrationDate2)
		$person : EvaluatedPerson($birthDate : demographics.birthTime)
		eval(TimePeriod.calculateElapsedTimePeriod($birthDate, $administrationDate1, DurationType.MONTHS).isLessThan(new TimePeriod(7, DurationType.MONTHS)) &&
			TimePeriod.calculateElapsedTimePeriod($birthDate, $administrationDate2, DurationType.MONTHS).isLessThan(new TimePeriod(12, DurationType.MONTHS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.getSeriesName());
		update($ts);
end

// /////////////////////////////////////////////////////////// Hep A-Specific Series Selection Rules Start Here /////////////////////////////////////////////////////////////

// Override general rule which picks the doses with the least number to complete the series
rule "SeriesSelection.HepADoNOTSelectAlreadyCompleteSeriesWithFewestDosesIfExistsAndOtherSeriesPreviouslySelected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	activation-group "SeriesSelectionFewestDoses"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		$ts : TargetSeries(selectedSeries == true, seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

// Function to select the default series for Hep A. 2-dose series may be converted to 3-dose series under certain conditions
function TargetSeries selectDefaultSeries(List possibleDefaultSeries)
{
    return (TargetSeries) possibleDefaultSeries.stream().filter(ts -> "SUPPORTED_SERIES.HepA2DoseChildAdultSeries".equals(((TargetSeries)ts).getSeriesName())).findFirst()
            .orElseGet(() -> possibleDefaultSeries.stream().filter(ts -> "SUPPORTED_SERIES.HepAAdult3DoseSeries".equals(((TargetSeries)ts).getSeriesName())).findFirst().orElse(null));
}

rule "SeriesSelection(Hep A): Determine default series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 60
	when
	    TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS))
        $possibleDefaultSeries : List(size > 0) from accumulate($ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A",
            seriesName in ("SUPPORTED_SERIES.HepA2DoseChildAdultSeries", "SUPPORTED_SERIES.HepAAdult3DoseSeries")); collectList($ts))
        $defaultSeries : TargetSeries() from selectDefaultSeries($possibleDefaultSeries)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Hep A Default series " + $defaultSeries);
end


// Hep A default series applies if patient has not received a dose of Hep A
rule "SeriesSelection(Hep A): Select default series if patient has not received a dose of Hep A"
    extends "SeriesSelection(Hep A): Determine default series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 60
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", selectedSeries == true)
		TargetSeries(targetSeriesIdentifier == $defaultSeries.targetSeriesIdentifier, selectedSeries == false)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", isValid == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $defaultSeries);
		$defaultSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($defaultSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
		update($defaultSeries);
		update($tss);
end

// Hep A default series applies if patient received a dose of Hep A < 18 years - 4 days
rule "SeriesSelection(Hep A): Select default series if patient received a dose of Hep A < 18 years - 4 days"
    extends "SeriesSelection(Hep A): Determine default series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 60
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", selectedSeries == true)
		TargetSeries(targetSeriesIdentifier == $defaultSeries.targetSeriesIdentifier, selectedSeries == false)
		$person : EvaluatedPerson($birthDate : demographics.birthTime,  $dateAt18yminus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
		TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", isValid == true, doseNumberInSeries == 1, administrationDate < $dateAt18yminus4d)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $defaultSeries);
		$defaultSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($defaultSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
		update($defaultSeries);
		update($tss);
end

// /////// ***
// Rules for patients >= 18 years - 4 days when they receive their first dose of Hep A
// /////// ***

// Abstract rule for patients >= 18 years - 4 days when they receive their first dose of Hep A
rule "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    extends "SeriesSelection(Hep A): Determine default series"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 60
    when
        $tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS))
        $ts3DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries")
        $person : EvaluatedPerson($birthDate : demographics.birthTime,  $dateAt18yminus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
        TargetDose(targetSeries == $ts3DoseSeries, doseNumberInSeries == 1, isValid == true, administrationDate >= $dateAt18yminus4d)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Hep A patient is >= 18 years - 4 days when first dose is administered");
end

// Initially select the default series if patient is >= 18 years - 4 days when first dose is administered (subsequent rules may override this)
rule "SeriesSelection(Hep A): Select default series (2-dose or 3-dose) if patient is >= 18 years - 4 days when first dose is administered"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 60
    when
        TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
        TargetSeries(targetSeriesIdentifier == $defaultSeries.targetSeriesIdentifier, selectedSeries == false)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $defaultSeries + " (default)");
        $defaultSeries.setSelectedSeries(true);
        $tss.setSelectedSeriesName($defaultSeries.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($defaultSeries);
        update($tss);
end

// Retract the default series and select the Hep A 4-dose series if the Hep B series selection logic selected the Hep B 4-dose Accelerated Twinrix Series.
// Must be higher salience than the 3-dose series selection rules below.
rule "SeriesSelection(Hep A): Select 4-dose Accelerated Twinrix series if Hep B 4-dose Accelerated Twinrix Series was selected"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 110
    when
        not ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep A Twinrix Series Override Applied")
        TargetSeries(targetSeriesIdentifier == $defaultSeries.targetSeriesIdentifier, selectedSeries == true)
        TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
        $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == false)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsTwinrix4DoseSeries + " (Hep A & Hep B dose 1-2 CVX 104; dose 2 7-24 days from dose 1; Hep B 4-dose Twinrix selected)");
        $tsTwinrix4DoseSeries.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsTwinrix4DoseSeries.seriesName);
        $defaultSeries.setSelectedSeries(false);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($tsTwinrix4DoseSeries);
        update($defaultSeries);
        update($tss);
end

// Retract the 2-dose series and select the 3-dose series if CVX 104 was administered as dose 1 and there are no other Hep A doses administered
rule "SeriesSelection(Hep A): Select 3-dose series if CVX 104 was administered as dose 1"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 60
    when
        not ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep A Twinrix Series Override Applied")
        $ts2DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA2DoseChildAdultSeries", selectedSeries == true)
        $tsAdult3DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() == 1)
        $td : TargetDose(associatedTargetSeries == $tsAdult3DoseSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", isValid == true, administrationDate != $td.administrationDate)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3DoseSeries + " CVX 104 was administered as dose 1 and no other Hep A doses administered");
        $tsAdult3DoseSeries.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsAdult3DoseSeries.seriesName);
        $ts2DoseSeries.setSelectedSeries(false);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($tsAdult3DoseSeries);
        update($ts2DoseSeries);
        update($tss);
end

// Retract the 2-dose series and select the 3-dose series if CVX 104 was administered as dose 1 and/or dose 2, and dose 2 was administered >= 24
// days and < 6 months - 4 days from dose 1.
rule "SeriesSelection(Hep A): Select 3-dose series if CVX 104 was administered as dose 1 and/or dose 2, and dose 2 was administered >= 24 days and < 6 months - 4 days from dose 1"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 60
    when
        not ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep A Twinrix Series Override Applied")
        $ts2DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA2DoseChildAdultSeries", selectedSeries == true)
        $tsAdult3DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() >= 2)
        $td1 : TargetDose(associatedTargetSeries == $tsAdult3DoseSeries, doseNumberInSeries == 1, isValid == true)
        $td2 : TargetDose(associatedTargetSeries == $tsAdult3DoseSeries, doseNumberInSeries == 2, isValid == true)
        eval((($td1.administeredVaccine.cdsConceptName == "VACCINE_CVX_104") || ($td2.administeredVaccine.cdsConceptName == "VACCINE_CVX_104")) &&
            TimePeriod.calculateElapsedTimePeriod($td1.administrationDate, $td2.administrationDate, DurationType.DAYS).isGreaterThanEqualTo(new TimePeriod(24, DurationType.DAYS)) &&
            $td2.administrationDate.compareTo(TimePeriod.addTimePeriod($td1.administrationDate, "6m-4d")) < 0)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3DoseSeries + " (CVX 104 in dose 1 and/or 2; dose 2 between 24 days and < 6m-4d from dose 1)");
        $tsAdult3DoseSeries.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsAdult3DoseSeries.seriesName);
        $ts2DoseSeries.setSelectedSeries(false);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($tsAdult3DoseSeries);
        update($ts2DoseSeries);
        update($tss);
end

// Retract the 4-dose series and select the 3-dose series if there are 3 valid doses in the Hep A 3-dose Series, but < 4 valid doses in the Hep A 4-dose Accelerated Twinrix Series
rule "SeriesSelection(Hep A): Select 3-dose series if 3 doses administered and < 4 doses administered in 4-dose series"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 60
    when
        $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == true, determineNumberOfDosesAdministeredInSeries() < 4)
        $tsAdult3DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() == 3)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3DoseSeries + " (3 doses administered in 3-dose series but < 4 doses administered in 4-dose series)");
        insert(new ICEFactTypeFinding("SeriesSelection: Hep A Twinrix Series Override Applied"));
        $tsTwinrix4DoseSeries.setSelectedSeries(false);
        $tss.setSelectedSeriesName($tsAdult3DoseSeries.seriesName);
        $tsAdult3DoseSeries.setSelectedSeries(true);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($tsTwinrix4DoseSeries);
        update($tsAdult3DoseSeries);
        update($tss);
end

// if there is a dose administered in the Hep A 3-dose Series where the administration date is after the latest dose in the Hep A 4-dose Accelerated
// Twinrix Series, and the Hep A 3-dose Series has fewer doses remaining to complete the series than the Hep A 4-dose Accelerated Twinrix Series,
// then select Hep A 3-dose Series.
 rule "SeriesSelection(Hep A): Select 3-dose series if Hep A 3-dose series with later dose has fewer doses remaining to complete the series than the Hep A 4-dose Accelerated Twinrix Series"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 100
    when
        $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == true, determineNumberOfDosesAdministeredInSeries() < 4)
        $latestTwinrixDose : TargetDose(associatedTargetSeries == $tsTwinrix4DoseSeries, isValid == true)
        not TargetDose(associatedTargetSeries == $tsTwinrix4DoseSeries, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        $tsAdult3DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false)
        TargetDose(associatedTargetSeries == $tsAdult3DoseSeries, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        eval(($tsAdult3DoseSeries.seriesRules.numberOfDosesInSeries - $tsAdult3DoseSeries.determineNumberOfDosesAdministeredInSeries()) < ($tsTwinrix4DoseSeries.seriesRules.numberOfDosesInSeries - $tsTwinrix4DoseSeries.determineNumberOfDosesAdministeredInSeries()))
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3DoseSeries + " (Hep A 3-dose series has fewer doses remaining than 4-dose Twinrix, with last 3-dose series dose after latest Twinrix dose)");
        insert(new ICEFactTypeFinding("SeriesSelection: Hep A Twinrix Series Override Applied"));
        $tsTwinrix4DoseSeries.setSelectedSeries(false);
        $tsAdult3DoseSeries.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsAdult3DoseSeries.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
        update($tsTwinrix4DoseSeries);
        update($tsAdult3DoseSeries);
        update($tss);
 end

// If a previously administered (Valid) dose in the (previously selected) Hep A/B 4-dose Accelerated Twinrix Series is Invalid in the Hep A 3-dose Series and the 3-dose series is selected, change
// its evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
rule "SeriesSelection(Hep A): If a shot in the Hep A 4-dose Accelerated Twinrix Series is invalid in the Hep A 3-dose Adult Series, mark any prior 3-dose Series doses as Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN in the 3-dose Series"
    extends "ABSTRACT SeriesSelection(Hep A): patient is >= 18 years - 4 days when first dose is administered"
 	dialect "mvel"
 	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
 	salience 60
 	when
        ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep B Twinrix Series Override Applied")
 	    $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == false)
 		$ts4dose : TargetDose(associatedTargetSeries == $tsTwinrix4DoseSeries, isValid == true)
 		$tsAdult : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesRules.seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == true)
 		$tsAdultDose : TargetDose(associatedTargetSeries == $tsAdult, administrationDate == $ts4dose.administrationDate, isValid == false, status != DoseStatus.ACCEPTED)
 	then
 		modify($tsAdultDose) {
 			setStatus(DoseStatus.ACCEPTED),
 			removeAllEvaluationReasonsFromAllReasonSets(),
 			addAcceptedReason("EVALUATION_REASON_CONCEPT.VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN")
 		};
 		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult + ", updated dose " + $tsAdultDose);
 end

// If the Hep A 3-dose series or Hep A 4-dose series is selected, but the Hep A 2-dose series was completed before the Hep A 3-dose series or Hep A 4-dose series,
// change the selection to the Hep A 2-dose complete series.
rule "SeriesSelection(Hep A): Select 2-dose series if 2-dose series is complete and 3-dose series is not complete or 2-dose series completed before 3-dose series"
   dialect "mvel"
   ruleflow-group "SeriesSelection^customSeriesSelectionRules"
   salience 60
   when
       $tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
       $ts2DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA2DoseChildAdultSeries", selectedSeries == false, isSeriesComplete() == true)
       $ts3DoseAdultSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries")
       $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries")
       eval(($ts3DoseAdultSeries.isSelectedSeries() && (!$ts3DoseAdultSeries.isSeriesComplete() || $ts2DoseSeries.lastShotAdministeredInSeries.administrationDate.before($ts3DoseAdultSeries.lastShotAdministeredInSeries.administrationDate))) ||
           ($tsTwinrix4DoseSeries.isSelectedSeries() && (!$tsTwinrix4DoseSeries.isSeriesComplete() || $ts2DoseSeries.lastShotAdministeredInSeries.administrationDate.before($tsTwinrix4DoseSeries.lastShotAdministeredInSeries.administrationDate))))
   then
       ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2DoseSeries + " (2-dose series completed before 3 or 4 dose series)");
       insert(new ICEFactTypeFinding("SeriesSelection: Hep A 3-Dose Series Override Applied"));
       $ts2DoseSeries.setSelectedSeries(true);
       $ts3DoseAdultSeries.setSelectedSeries(false);
       $tsTwinrix4DoseSeries.setSelectedSeries(false);
       $tss.setSelectedSeriesName($ts2DoseSeries.seriesName);
       $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
       update($tss);
       update($ts2DoseSeries);
       update($ts3DoseAdultSeries);
       update($tsTwinrix4DoseSeries);
end

// If a previously administered (Valid) dose in the (previously selected) Hep A 3-Dose Series or 4-dose Accelerated Twinrix Series is Invalid in the Hep A 2-dose Series and the 2-dose series is selected, change
// its evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
rule "SeriesSelection(Hep A): If a shot in the Hep A 2-dose or 3-dose Series is invalid in the Hep A 2-dose Series, mark any prior 2-dose Series doses as Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN in the 2-dose Series"
 	dialect "mvel"
 	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
 	salience 60
 	when
 	    ICEFactTypeFinding(iceResultFinding in ("SeriesSelection: Hep A 3-Dose Series Override Applied", "SeriesSelection: Hep A Twinrix Series Override Applied", "SeriesSelection: Hep B Twinrix Series Override Applied"))
 	 	$ts2DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA2DoseChildAdultSeries", selectedSeries == true)
 	 	$ts3DoseAdultSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false)
 	    $tsTwinrix4DoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == false)
 		$tsValidDose : TargetDose(associatedTargetSeries == $ts3DoseAdultSeries || associatedTargetSeries == $tsTwinrix4DoseSeries, isValid == true)
 		$ts2Dose : TargetDose(associatedTargetSeries == $ts2DoseSeries, administrationDate == $tsValidDose.administrationDate, isValid == false, status != DoseStatus.ACCEPTED)
 	then
 		modify($ts2Dose) {
 			setStatus(DoseStatus.ACCEPTED),
 			removeAllEvaluationReasonsFromAllReasonSets(),
 			addAcceptedReason("EVALUATION_REASON_CONCEPT.VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN")
 		};
 		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts2DoseSeries + ", updated dose " + $ts2Dose);
 end

// /////////////////////////////////////////////////////////// Hep B-Specific Series Selection Rules Start Here /////////////////////////////////////////////////////////////

// Undo selection of Hep B 3-dose Twinrix series if Hep A 3-dose Adult series was not selected
rule "SeriesSelection(Hep B): Undo select of Hep B 3-dose Twinrix series if Hep A 3-dose Adult series was not selected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tssHepA : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS))
		$tssHepB : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName == "SUPPORTED_SERIES.HepB3DoseTwinrixSeries", selectedSeries == true)
		TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts + " reverted (Hep A 3-dose series was not selected)");
		$ts.setSelectedSeries(false);
		$tssHepA.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		$tssHepB.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS);
		update($ts);
		update($tssHepA);
		update($tssHepB);
end

// Undo selection of Hep B 4-dose Twinrix series if Hep A 4-dose Twinrix series was not selected
rule "SeriesSelection(Hep B): Undo select of Hep B 4-dose Twinrix series if Hep A 4-dose Twinrix series was not selected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tssHepA : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS))
		$tssHepB : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
		TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts + " reverted (Hep A 4-dose series was not selected)");
		$ts.setSelectedSeries(false);
		$tssHepA.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		$tssHepB.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS);
		update($ts);
		update($tssHepA);
		update($tssHepB);
end

// Finalize selection of the Hep B 3-dose Twinrix series if Hep A 3-dose Adult series was selected
 rule "SeriesSelection(Hep B): Finalize selection of the Hep B 3-dose Twinrix series if Hep A 3-dose Adult series was selected"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    when
        $tssHepA : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS))
        $tssHepB : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
        $ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName == "SUPPORTED_SERIES.HepB3DoseTwinrixSeries", selectedSeries == true)
        TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries", selectedSeries == true)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Finalize Hep B 3-dose Twinrix series " + $ts);
        $tssHepA.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        $tssHepB.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tssHepA);
        update($tssHepB);
end

// Finalize selection of the Hep B 4-dose Twinrix series if Hep A 4-dose Twinrix series was selected
 rule "SeriesSelection(Hep B): Finalize selection of the Hep B 4-dose Twinrix series if Hep A 4-dose Twinrix series was selected"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    when
        $tssHepA : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS))
        $tssHepB : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
        $ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
        TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries", selectedSeries == true)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Finalize Hep B 4-dose Twinrix series " + $ts);
        $tssHepA.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        $tssHepB.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tssHepA);
        update($tssHepB);
end

// Finalize selection of the selected Hep A series if Hep B series selection is complete and Hep A series selection is not complete
rule "SeriesSelection(Hep A): Finalize selection of the selected Hep A series if Hep B series selection is complete and Hep A series selection is not complete"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    when
        $tssHepA : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
        TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_COMPLETE)
        TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", selectedSeries == true)
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Finalize Hep A series " + $tssHepA.getSelectedSeriesName());
        $tssHepA.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tssHepA);
end

rule "SeriesSelection(Hep B): Select already completed series that was completed on the same date and with the most doses if different completed series was previously selected"
	dialect "java"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", $ssvg : seriesSelectionVaccineGroup,
			seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS || seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, $sss : seriesSelectionSeason)
		$ts1 : TargetSeries(seriesRules.vaccineGroup == $ssvg, $id1 : targetSeriesIdentifier, selectedSeries == true, targetSeason == null || targetSeason == $sss, $seriesComplete1 : isSeriesComplete(),
			$lastNecessaryShotAdministered1 : getValidShotByDoseNumber(seriesRules.numberOfDosesInSeries), $ts1numberOfDosesInSeries : seriesRules.numberOfDosesInSeries)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == $ssvg, targetSeriesIdentifier != $id1, selectedSeries == false, targetSeason == null || targetSeason == $sss, $seriesComplete2 : isSeriesComplete(),
			$ts2numberOfDosesInSeries : seriesRules.numberOfDosesInSeries, $ts2numberOfDosesInSeries > $ts1numberOfDosesInSeries, $lastNecessaryShotAdministered2 : getValidShotByDoseNumber(seriesRules.numberOfDosesInSeries))
		eval($seriesComplete1 == true && $seriesComplete2 == true && $lastNecessaryShotAdministered1 != null && $lastNecessaryShotAdministered2 != null &&
			TimePeriod.differenceInDays($lastNecessaryShotAdministered1.getAdministrationDate(), $lastNecessaryShotAdministered2.getAdministrationDate()) == 0)
	then
		$ts1.setSelectedSeries(false);
		$ts2.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2.getSeriesName());
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($ts1);
		update($ts2);
		update($tss);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Previously Selected TargetSeries Retracted for Already Complete Series: " + $ts2 + "; " + $lastNecessaryShotAdministered1 + "; " + $lastNecessaryShotAdministered2);
end

rule "SeriesSelection(Hep B): Select Hep B Newborn Series if at least one shot administered at <= 27 days of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
		$td : TargetDose(associatedTargetSeries.seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", administeredShotNumberInSeries == 1)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBNewbornSeries", selectedSeries == false, containsTargetDose($td))
		$person : EvaluatedPerson()
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.DAYS).isLessThanEqualTo(new TimePeriod(27, DurationType.DAYS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(Hep B): Select Hep B Newborn Series if no shots have been administered and patient is <= 27 days of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	no-loop true
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBNewbornSeries", selectedSeries == false, targetDoses.empty)
		$person : EvaluatedPerson()
		$evalTime: EvalTime()
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $evalTime.evalTimeValue,	DurationType.DAYS).isLessThanEqualTo(new TimePeriod(27, DurationType.DAYS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(Hep B): Select Hep B Child/Adolescent series if the patient is >= 28 days and < 19 years of age when first shot was administered"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	no-loop true
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
		$td : TargetDose(associatedTargetSeries.seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", administeredShotNumberInSeries == 1)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", selectedSeries == false, containsTargetDose($td))
		$person : EvaluatedPerson()
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.DAYS).isGreaterThanEqualTo(new TimePeriod(28, DurationType.DAYS)))
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isLessThan(new TimePeriod(19, DurationType.YEARS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

