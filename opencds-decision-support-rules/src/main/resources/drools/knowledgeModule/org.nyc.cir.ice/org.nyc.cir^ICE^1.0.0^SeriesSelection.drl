// These series selection rules assume the existence of the following series only:
//    + Mpox 1-Dose Series
//    + Mpox 2-Dose Series
rule "SeriesSelection(Mpox): If a (valid) dose 1 of the Mpox 2-dose series was administered and no other doses were administered in another series prior to this shot, the Mpox 2-dose series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 20
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == true)
		$td : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", isValid == true, doseNumberInSeries == 1, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.Mpox2DoseSeries", $ts : associatedTargetSeries)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", isValid == true, associatedTargetSeries != $ts, administrationDate < $td.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(Mpox): If a (valid) dose 1 of the Mpox 1-dose series was administered and no other doses were administered in another series prior to this shot, the Mpox 1-dose series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == true)
		$td : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", isValid == true, doseNumberInSeries == 1, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.Mpox1DoseSeries", $ts : associatedTargetSeries)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", isValid == true, associatedTargetSeries != $ts, administrationDate < $td.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

// If a series was selected but another series was marked complete with fewer doses, select the series with fewer doses
rule "SeriesSelect(Mpox): If a series was selected but another series was marked complete earlier, select the series that was complete earlier"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
		$ts1 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == true, isSeriesComplete() == true, $dcts1 : doseAfterWhichSeriesWasMarkedComplete)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == false, isSeriesComplete() == true, $dcts2: doseAfterWhichSeriesWasMarkedComplete)
		$td1 : TargetDose(associatedTargetSeries == $ts1, isValid == true, doseNumberInSeries == $dcts1)
		exists TargetDose(associatedTargetSeries == $ts2, doseNumberInSeries == $dcts2, isValid == true, administrationDate < $td1.administrationDate)
	then
		$ts1.setSelectedSeries(false);
		$ts2.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Previously Selected TargetSeries " + $ts1 + " reverted ==> Newly selected series: " + $ts2);
		update($tss);
		update($ts1);
		update($ts2);
end

// If one series is complete but another has been selected, select an already completed one.
rule "SeriesSelection(Mpox): Select already _completed_ series if a different, _incomplete_ series was previously selected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 10
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
		$ts1 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == true, isSeriesComplete() == false)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == false, isSeriesComplete() == true)
	then
		$ts1.setSelectedSeries(false);
		$ts2.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Previously Selected TargetSeries Reverted. Newly selected series: " + $ts2);
		update($tss);
		update($ts1);
		update($ts2);
end

rule "SeriesSelection(Mpox): If no other series was selected, the Mpox 2-dose series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MPOX", seriesRules.seriesName == "SUPPORTED_SERIES.Mpox2DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

// If the patient is >= 20 months of age, then the RSV Adult Series; otherwise the RSV Infant Series applies.
rule "SeriesSelection(RSV): Select the RSV Infant Series if the Adult Series was not selected for any dose in the RSV Infant Series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", selectedSeries == true, targetSeason == $tss.seriesSelectionSeason, seriesRules.seriesGroup == $tss.seriesGroup)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", seriesRules.seriesName == "SUPPORTED_SERIES.RSVInfantSeries", targetSeason == $tss.seriesSelectionSeason, seriesRules.seriesGroup == $tss.seriesGroup)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(RSV): Select the RSV Adult Series if the patient is >= 20 months of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", selectedSeries == true, seriesRules.seriesGroup == $tss.seriesGroup)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.RSV", seriesRules.seriesName == "SUPPORTED_SERIES.RSVAdultSeries", seriesRules.seriesGroup == $tss.seriesGroup)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

// Start COVID Series Selection Rules Aug2025+ Season
rule "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName == "SUPPORTED_SEASON.COVID19Aug2025Season")
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$person : EvaluatedPerson($dateAt2yrs : TimePeriod.addTimePeriod(demographics.birthTime, "2y"), $dateAt65yrs : TimePeriod.addTimePeriod(demographics.birthTime, "65y"))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Aug2025 2 and 65 year thresholds calculated")
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 2-dose COVID-19 Series (< 2 years) if patient is < 2 years of age as of evaluation date, or patient is >= 2 years and has a shot administered in current season at < 2 years of age"
	extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		(
			eval(evalTime.compareTo($dateAt2yrs) < 0)
			or
			(
				eval(evalTime.compareTo($dateAt2yrs) >= 0)
				and
				exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", administrationDate < $dateAt2yrs, associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason)
			)
		)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug2025lt2Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
 	ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 1-dose COVID-19 Series (>= 2 - 64 years) if patient has no in-season shots and is >= 2 years and < 65 years as of evaluation date"
	extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 50
	when
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug20252yTo64ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		eval(evalTime.compareTo($dateAt2yrs) >= 0 && evalTime.compareTo($dateAt65yrs) < 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 2-dose COVID-19 Series (>= 65 years) if patient has no in-season shots and is >= 65 years as of evaluation date"
	extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 50
	when
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug2025gte65Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		eval(evalTime.compareTo($dateAt65yrs) >= 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 1-dose COVID-19 Series (>= 2 - 64 years) if patient has in-season shots administered at >= 2 years and target dose 1 received at age < 65 years"
	extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 50
	when
		$td1 : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", doseNumberInSeries == 1, administrationDate >= $dateAt2yrs,  associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason,
			$dose1AdminDate : administrationDate)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug20252yTo64ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		eval($dose1AdminDate.compareTo($dateAt65yrs) < 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 2-dose COVID-19 Series (>= 65 years) if patient has in-season shots administered and target dose 1 received at age >= 65 years"
	extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 50
	when
		$td1 : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", doseNumberInSeries == 1, administrationDate >= $dateAt65yrs, associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug2025gte65Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Aug2025+): Select the Seasonal 2-dose COVID-19 Series (>= 65 years) if patient if dose 1 is administered to a patient that will turn 65 within 12 months of season start date"
        extends "SeriesSelection(COVID-19 Aug2025+ Abstract): In Aug2025 season, determine date at which patient turns 2 and 65 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 50
	when
		$td1 : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", doseNumberInSeries == 1, administrationDate < $dateAt65yrs,
		                  associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, $seasonStartDate : associatedTargetSeries.seasonStartDate)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Aug2025gte65Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		eval($seasonStartDate != null && $seasonStartDate.compareTo($dateAt65yrs) < 0)
        eval($seasonStartDate != null && TimePeriod.compareElapsedTimePeriodToDateRange($seasonStartDate, $dateAt65yrs, "12m") <= 0)
	then
        $ts.setSelectedSeries(true);
        $tss.setSelectedSeriesName($ts.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tss);
        update($ts);
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

// /////// ***
// Start COVID Series Selection Rules Pre-Aug2025+ Season
// /////// ***

// If one series is complete but another has been selected, selected an already completed one.
// This is the only way a non-FDA, WHO-approved series can be selected (it must be complete).
// If there is more than one series that has been complete, this rule picks one of them, and the general rules will pick the
// earliest completed.
rule "SeriesSelection(COVID-19 Pre-Aug25): Select already _completed_ series if a different, _incomplete_ series was previously selected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	activation-group "SeriesSelection^COVID19Sep2023^customSeriesSelectionCompletionRules"
	salience 5
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS || seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS,
		       seriesSelectionSeason.fullySpecifiedSeasonStartDate.isBefore(LocalDate.of(2025, 8, 27)))
		$ts1 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, isSeriesComplete() == false, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == false, isSeriesComplete() == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
	then
		$ts1.setSelectedSeries(false);
		$ts2.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts2.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Previously Selected TargetSeries Reverted. Newly selected series: " + $ts2);
		update($tss);
		update($ts1);
		update($ts2);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024 Adult Series): Do NOT select already _completed_ Sep2023/Aug2024 _Child_ series if a different, _incomplete_ Sep2023/Aug2024 _Adult_ series was previously selected and there are no doses at < 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	activation-group "SeriesSelection^COVID19Sep2023^customSeriesSelectionCompletionRules"
	salience 6
	when
		$tss: TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS || seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
		$ts1 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, isSeriesComplete() == false, targetSeason != null && targetSeason == $tss.seriesSelectionSeason, seriesRules.seriesName in ("SUPPORTED_SERIES.COVID19Sep2023gte5Series", "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries"))
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == false, isSeriesComplete() == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason,
			seriesRules.seriesName in ("SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries", "SUPPORTED_SERIES.COVID19Sep2023PfizerLT5ySeries", "SUPPORTED_SERIES.COVID19Sep2023ModernaLT5ySeries"))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Previously Selected TargetSeries NOT Reverted");
end

rule "SeriesSelect(COVID-19 Sep2023/Aug2024): Catch All-- Select the Mixed Product Series if no other series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"))
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries")
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"))
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$person : EvaluatedPerson($birthDate : demographics.birthTime,  $dateAt5yrs : TimePeriod.addTimePeriod(demographics.birthTime, "5y"))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection")
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 12y-4d years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"))
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$person : EvaluatedPerson($birthDate : demographics.birthTime,  $dateAt12yrs : TimePeriod.addTimePeriod(demographics.birthTime, "12y-4d"))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection")
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): Select the Mixed Product < 5 yrs series if any doses were administered in the current season prior to 5 yrs of age, and there are a mix of products used"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 25
	when
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", isValid == true, administrationDate < $dateAt5yrs, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason)
		(
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName in ("VACCINE_CVX_311", "VACCINE_CVX_312"))
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_311", "VACCINE_CVX_312"))
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName in ("VACCINE_CVX_308", "VACCINE_CVX_309", "VACCINE_CVX_310"))
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_308", "VACCINE_CVX_309", "VACCINE_CVX_310"))
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName in ("VACCINE_CVX_211", "VACCINE_CVX_313"))
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_211", "VACCINE_CVX_313"))
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.isUnspecifiedFormulation() == true)
		)
		$tsmixedproduct : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries")
	then
		$tsmixedproduct.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsmixedproduct.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsmixedproduct);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsmixedproduct);
end

rule "SeriesSelect(COVID-19 Sep2023/Aug2024): Select the COVID-19 Mixed Product < 5y series if patient is < 5 years of age and there are no doses on record in the current season"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 25
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, administrationDate < $dateAt5yrs)
		eval(evalTime.compareTo($dateAt5yrs) < 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): If a >= 5yrs Series is completed but the previously selected Novavax Series is not, then the >= 5yr Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 26
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"), seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_COMPLETE))
		$tsnovavax : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, selectedSeries == true, isSeriesComplete() == false)
		$tsgte5yrs : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, selectedSeries == false, isSeriesComplete() == true)
	then
		$tsgte5yrs.setSelectedSeries(true);
		$tsnovavax.setSelectedSeries(false);
		$tss.setSelectedSeriesName($tsgte5yrs.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsgte5yrs);
		update($tsnovavax);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsgte5yrs);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): If a Novavax 2023 Series is completed but the previously selected >= 5y Series is not, then the Novavax 2023 Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 26
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"), seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_COMPLETE))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, selectedSeries == true, isSeriesComplete() == false)
		$tsnovavax : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, selectedSeries == false, isSeriesComplete() == true)
	then
		$tsnovavax.setSelectedSeries(true);
		$ts.setSelectedSeries(false);
		$tss.setSelectedSeriesName($tsnovavax.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		update($tsnovavax);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

// If the patient has no prior COVID-19 doses on record before 9/12/2023, and dose 1 in a Sept 2023 series is Novavax (CVX 211, CVX
// 313), and there are no other doses after dose 1 (in a Sept 2023 series), and dose 1 was administered at >= 12 years, then the
// Sept 2023 Novavax Series applies. and dose 1 was administered at < 12 years, then the Sept 2023 COVID-19 Series (>= 5 years)
// applies. and dose 2 (in a Sept 2023 series) is Novavax (CVX 211, CVX 313), then the Sept 2023 Novavax Series applies.
//   dose 1 in Sept 2023 series is not Novavax (CVX 211, CVX 313), then the Sept 2023 COVID-19 Series (>= 5 years) applies.
rule "SeriesSelection(COVID-19 Sep2023/Aug2024): If the patient is >= 5 years of age and there are no doses on record at >= 5 years in the current season, then COVID-19 >= 5y Series applies"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 27
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, administrationDate >= $dateAt5yrs)
		eval(evalTime.compareTo($dateAt5yrs) >= 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelect(COVID-19 Sep2023/Aug2024): If patient is >= 5 years of age and there are no doses on record at < 5 years of age in the current season, then the COVID-19 >= 5y series"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 27
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, isValid == true, administrationDate < $dateAt5yrs)
		eval(evalTime.compareTo($dateAt5yrs) >= 0)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): If the first dose administered is the Novavax vaccine at >= 12 years of age, there are no other doses after dose 1 in another series, and there are no doses in the prior season, then the Novavax 2023 Series applies"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 12y-4d years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 28
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason != $tss.seriesSelectionSeason, associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true)
		$td : TargetDose(associatedTargetSeries == $ts, doseNumberInSeries == 1, isValid == true, administrationDate >= $dateAt12yrs)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries != $ts, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason,
			isValid == true)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): If the first 2 doses is Novavax (CVX 211, CVX 311) and there are no doses in the prior seasons, then the Novavax 2023 Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 28
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName in ("SUPPORTED_SEASON.COVID19Sep2023Season", "SUPPORTED_SEASON.COVID19Aug2024Season"))
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason != $tss.seriesSelectionSeason, associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true)
		$td1 : TargetDose(associatedTargetSeries == $ts, doseNumberInSeries == 1,  isValid == true)
		$td2 : TargetDose(associatedTargetSeries == $ts, doseNumberInSeries == 2, isValid == true)
		 not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries != $ts, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023gte5Series", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason, doseNumberInSeries == 1,
		 	isValid == true, administrationDate < $td1.administrationDate)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

// If the patient is < 5 years of age as of 9/12/23,
//   If all the prior season doses (if any) are all Moderna, and all shots in the current season are Moderna, then the Moderna
//   series applies.
//   If all the prior season doses (if any) are all Pfizer, and all shots in the current season are Pfizer, then the Pfizer series
//   applies.
//   and neither of the above two conditions are true, then the Sept 2023 Mixed Product COVID-19 Series (< 5 years) applies.
rule "SeriesSelection(COVID-19 Sep2023/Aug2024): Select the Mixed Product Series < 5 yrs if at least one dose (if any) in the prior season doses was administered at < 5 yrs of age, all doses (if any) in the prior season are a mix of vaccines, and all shots (if any) in the current season are a mix of 2023 vaccines"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 29
	when
		$ts : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023MixedProductLT5ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		(
			exists TargetDose(associatedTargetSeries == $ts, administrationDate < $dateAt5yrs)
			or
			eval(evalTime < $dateAt5yrs)
			or
			(
				$tspriorseasonseries : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", targetSeason != null, isSeriesComplete() == false, targetSeason.startsBeforeStartDate($ts.targetSeason, false))
				and
				exists TargetDose(associatedTargetSeries == $tspriorseasonseries, isValid == true, administrationDate < $dateAt5yrs)
				and
				not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", this != $tspriorseasonseries, targetSeason != null, targetSeason.startsAfterStartDate($tspriorseasonseries.targetSeason, false), targetSeason.startsBeforeStartDate($ts.targetSeason, false))
			)
		)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): Select the Pfizer < 5 yrs series if at least one dose (if any) in the prior season was administered at < 5 yrs of age, all doses (if any) in the all seasons are Pfizer vaccines:, and all shots (if any) are in the current season are a Pfizer vaccine"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023PfizerLT5ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason || associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true,
			vaccineComponent.cdsConceptName not in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302", "VACCINE_CVX_308", "VACCINE_CVX_309", "VACCINE_CVX_310", "VACCINE_CVX_520"), associatedTargetSeries.seriesRules.seriesName not in ("SUPPORTED_SERIES.COVID19Sep2023gte5Series", "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries"))
		and
		exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason || associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true,
			vaccineComponent.cdsConceptName in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302", "VACCINE_CVX_308", "VACCINE_CVX_309", "VACCINE_CVX_310", "VACCINE_CVX_520"))
		and
		(
			eval(evalTime < $dateAt5yrs)
			or
			(
				exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries == $ts, administrationDate < $dateAt5yrs)
				or
				exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", administrationDate < $dateAt5yrs, isValid == true, associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false))
				and
				$tspriorseasonseries : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", targetSeason != null, isSeriesComplete() == false, targetSeason.startsBeforeStartDate($ts.targetSeason, false))
				and
				not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", this != $tspriorseasonseries, targetSeason != null, targetSeason.startsAfterStartDate($tspriorseasonseries!.targetSeason, false), targetSeason.startsBeforeStartDate($ts!.targetSeason, false))
			)
		)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Sep2023/Aug2024): Select the Moderna < 5 yrs series if at least one dose (if any) in the prior season was administered at < 5 yrs of age, all doses (if any) in the prior season are Moderna vaccines, and all shots (if any) in the current season are a Moderna vaccine"
	extends "SeriesSelection(COVID-19 Sep2023/Aug2024 Abstract): In Sep2023/Aug2024 seasons, determine date at which patients turns 5 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Sep2023ModernaLT5ySeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason || associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true,
			vaccineComponent.cdsConceptName not in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230", "VACCINE_CVX_311", "VACCINE_CVX_312", "VACCINE_CVX_519"), associatedTargetSeries.seriesRules.seriesName not in ("SUPPORTED_SERIES.COVID19Sep2023gte5Series", "SUPPORTED_SERIES.COVID19Sep2023NovavaxSeries"))
		and
		exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries!.targetSeason == $tss.seriesSelectionSeason || associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false), isValid == true,
			vaccineComponent.cdsConceptName in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230", "VACCINE_CVX_311", "VACCINE_CVX_312", "VACCINE_CVX_519"))
		and
		(
			eval(evalTime < $dateAt5yrs)
			or
			(
				exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries == $ts, administrationDate < $dateAt5yrs)
				or
				exists TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", administrationDate < $dateAt5yrs, isValid == true, associatedTargetSeries!.targetSeason.startsBeforeStartDate($ts.targetSeason, false))
				and
				$tspriorseasonseries : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", targetSeason != null, isSeriesComplete() == false, targetSeason.startsBeforeStartDate($ts.targetSeason, false))
				and
				not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", this != $tspriorseasonseries, targetSeason != null, targetSeason.startsAfterStartDate($tspriorseasonseries!.targetSeason, false), targetSeason.startsBeforeStartDate($ts!.targetSeason, false))
			)
		)
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Dec2020): Select the Mixed Series by default if no valid NOS shots on record"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason!.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", isValid == true, associatedTargetSeries.seriesRules.seriesName in ("SUPPORTED_SERIES.COVID19PfizerSeries", "SUPPORTED_SERIES.COVID19ModernaSeries", "SUPPORTED_SERIES.COVID19MixedProductSeries", "SUPPORTED_SERIES.COVID19Janssen1DoseSeries"),
			vaccineComponent.isUnspecifiedFormulation() == false)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19MixedProductSeries")
	then
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(COVID-19 Dec2020): If the earliest, non-NOS (Valid) _dose_ was not found in the Pfizer, Moderna, Mixed Product or Janssen series (see related rules), then select the another (i.e. - WHO series) that has the earliest, non-NOS (Valid) _dose_ administered to it"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 25
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$td : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.isUnspecifiedFormulation() == false)
		$ts : TargetSeries(this == $td.associatedTargetSeries, getPreferableVaccinesForTargetDose($td.doseNumberInSeries) contains $td.administeredVaccine)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries != $ts, associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.isUnspecifiedFormulation() == false, administrationDate < $td.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

rule "SeriesSelection(COVID-19 Dec2020): If the Janssen Series was not selected nor were all administered doses a Moderna, Pfizer or Novavax vaccine (i.e.- none of Moderna-only, Pfizer-only or Novavax-only Series are applicable), but (Valid) doses exist in the Mixed Product Series, then select the Mixed Product Series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 28
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", isValid == true, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19MixedProductSeries", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason)
		(
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230"))
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230"))
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302"))
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302"))
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName == "VACCINE_CVX_211")
			and
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName != "VACCINE_CVX_211")
			or
			exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.isUnspecifiedFormulation() == true)
		)
		$tsmixedproduct : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19MixedProductSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsmixedproduct);
		$tsmixedproduct.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsmixedproduct.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($tsmixedproduct);
end

rule "SeriesSelection(COVID-19 Dec2020): If all administered doses are a Moderna vaccine and the valid shot(s) are in the Moderna series, then the Moderna Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		and
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", isValid == true, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19ModernaSeries", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason)
		and
		(
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19ModernaSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == true)
			and
			$tdts : TargetDose(associatedTargetSeries == $ts, isValid == true, doseNumberInSeries == $ts.doseAfterWhichSeriesWasMarkedComplete)
			and
			not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230"),
				administrationDate < $tdts.administrationDate)
			or
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19ModernaSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == false)
			and
			not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_207", "VACCINE_CVX_221", "VACCINE_CVX_227", "VACCINE_CVX_228", "VACCINE_CVX_229", "VACCINE_CVX_230"))
		)
		and
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.isUnspecifiedFormulation() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

rule "SeriesSelection(COVID-19 Dec2020): If all administered doses are a Pfizer vaccine and the valid shot(s) are in the Pfizer series, then the Pfizer Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		and
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", isValid == true, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19PfizerSeries", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason)
		and
		(
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19PfizerSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == true)
			and
			$tdts : TargetDose(associatedTargetSeries == $ts, isValid == true, doseNumberInSeries == $ts.doseAfterWhichSeriesWasMarkedComplete)
			and
			not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302"),
				administrationDate < $tdts.administrationDate)
			or
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19PfizerSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == false)
			and
			not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName not in ("VACCINE_CVX_208", "VACCINE_CVX_217", "VACCINE_CVX_218", "VACCINE_CVX_219", "VACCINE_CVX_300", "VACCINE_CVX_301", "VACCINE_CVX_302"))
		)
		and
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.isUnspecifiedFormulation() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

rule "SeriesSelection(COVID-19 Dec2020): If all administered doses are a Novavax vaccine and the valid shot(s) are in the Novavax series, then the Novavax Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 30
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		and
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		and
		exists TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Novavax2DoseSeries")
		and
		(
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Novavax2DoseSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == true)
			or
			$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Novavax2DoseSeries", targetSeason != null && targetSeason == $tss.seriesSelectionSeason, isSeriesComplete() == false)
			and
			not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName != "VACCINE_CVX_211")
		)
		and
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.isUnspecifiedFormulation() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

// Select the Janssen series if it has the earliest (Valid) dose administered to it. Mark the series for post-processing so that
// series selection catch-all rules will be activated; in the case that the Janssen vaccine was administered after a Pfizer, Moderna
// or non-FDA series and the Pfizer/Moderna/non-FDA series is not complete, the catch all selection rule that examines for earliest
// completed series will override this rule.
rule "SeriesSelection(COVID-19 Dec2020): If the first dose administered is the Janssen vaccine, then the Janssen Series applies"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 40
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, seriesSelectionSeason.seasonName == "SUPPORTED_SEASON.COVID19Dec2020Season")
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", selectedSeries == true, targetSeason != null && targetSeason == $tss.seriesSelectionSeason)
		$td : TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, isValid == true, vaccineComponent.cdsConceptName == "VACCINE_CVX_212",
			associatedTargetSeries.seriesRules.seriesName == "SUPPORTED_SERIES.COVID19Janssen1DoseSeries", $ts : associatedTargetSeries)
		not TargetDose(associatedVaccineGroup == "VACCINE_GROUP_CONCEPT.COVID_19", associatedTargetSeries.targetSeason != null && associatedTargetSeries.targetSeason == $tss.seriesSelectionSeason, vaccineComponent.cdsConceptName != "VACCINE_CVX_212", isValid == true,
			vaccineComponent.isUnspecifiedFormulation() == false, administrationDate < $td.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

// /////// ***
// End COVID Series Selection Rules
// /////// ***

rule "SeriesSelection(MenB): Select MenB 4C 2-Dose Series by default"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience -1
	when
$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries", isSeriesComplete() == false)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(MenB): Select the MenB series with the most doses if no series is complete"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
		$ts : TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", $numberOfDosesRemaining : seriesRules.numberOfDosesInSeries - determineNumberOfDosesAdministeredInSeries())
		not TargetSeries(vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", this != $ts, seriesRules.numberOfDosesInSeries - determineNumberOfDosesAdministeredInSeries() > $numberOfDosesRemaining)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

// If the 2-dose series was selected and is complete, but the 3-dose series is also complete, and was either completed on the same
// day or sooner
rule "SeriesSelection(MenB FHbp): Select 3-dose series if both 2-dose and 3-dose series are complete but the 3-dose series was completed on the same day or before the 2-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp2DoseSeries", selectedSeries == true, isSeriesComplete() == true)
		$ts3 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenBFHbp3DoseSeries", selectedSeries == false, isSeriesComplete() == true)
		$ts2dose2 : TargetDose(associatedTargetSeries == $ts2, doseNumberInSeries == 2, isValid == true)
		TargetDose(associatedTargetSeries == $ts3, doseNumberInSeries == 3, isValid == true, administrationDate <= $ts2dose2.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3);
		$ts2.setSelectedSeries(false);
		$ts3.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts2);
		update($ts3);
end

rule "SeriesSelection(MenB 4C): Select 3-dose series if both 2-dose and 3-dose series are complete but the 3-dose series was completed on the same day or before the 2-dose series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS)
		$ts2 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries", selectedSeries == true, isSeriesComplete() == true)
		$ts3 : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C3DoseSeries", selectedSeries == false, isSeriesComplete() == true)
		$ts2dose2 : TargetDose(associatedTargetSeries == $ts2, doseNumberInSeries == 2, isValid == true)
		TargetDose(associatedTargetSeries == $ts3, doseNumberInSeries == 3, isValid == true, administrationDate <= $ts2dose2.administrationDate)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3);
		$ts2.setSelectedSeries(false);
		$ts3.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts2);
		update($ts3);
end

// If one or more of the series is complete, pick it; leave it to default series selection rules to determine which series was
// complete first
rule "SeriesSelection(MenB): Select Complete Series"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

// Because there is a possibility in the Evaluation Stage that there was a switch from the 4C 2-dose Series to the 3-dose Series
// during evaluation,
rule "SeriesSelection(MenB): Select available MenB 4C 3-dose if there is no MenB 4C 2-dose Series and a MenB 4C Series should be selected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 1
	when
		exists ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Select MenB 4C Series");
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries")
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C3DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts3doseSeries);
end

// If target dose 1 is CVX 163 (Meningococcal B 4C, OMV (Bexsero)) and:
//   Invalid for the MenB 4C 2-dose Series, but valid for MenB 4C 3-dose Series, the MenB 4C 3-dose series applies.
//   Valid for the MenB 4C 2-dose Series AND valid for MenB 4C 3-dose Series, the MenB 4C 2-dose series applies.
//
// Sub-bullet 1:
//   Invalid for the MenB 4C 2-dose Series, but valid for MenB 4C 3-dose Series, the MenB 4C 3-dose series applies.
rule "ABSTRACT SeriesSelection(MenB): Select MenB 4C 3-Dose Series if it has a (valid) dose 1 and but MenB 4C 2-Dose Series does not have a (valid) dose 1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 5
	when
		exists ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Select MenB 4C Series");
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts2doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries")
		not TargetDose(associatedTargetSeries == $ts2doseSeries, isValid == true)
		$ts3doseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C3DoseSeries")
		$td3dose : TargetDose(associatedTargetSeries == $ts3doseSeries, vaccineComponent.cdsConceptName in ("VACCINE_CVX_163", "VACCINE_CVX_328"))
		not TargetDose(associatedTargetSeries == $td3dose.associatedTargetSeries, administrationDate > $td3dose.administrationDate)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName not in ("VACCINE_CVX_163", "VACCINE_CVX_328"), administrationDate > $td3dose.administrationDate, isValid == true)
		eval($ts3doseSeries.determineNumberOfDosesAdministeredInSeries() >= 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
end

rule "SerieSelection(MenB): Select MenB 4C 3-dose series if target dose 1 (CVX 163, CVX 328) is Valid; series _is_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB 4C 3-Dose Series if it has a (valid) dose 1 and but MenB 4C 2-Dose Series does not have a (valid) dose 1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 5
	when
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts3doseSeries);
end

rule "SerieSelection(MenB): Select MenB 4C 3-dose series if target dose 1 (CVX 163, CVX 328) is Valid; series is _not_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB 4C 3-Dose Series if it has a (valid) dose 1 and but MenB 4C 2-Dose Series does not have a (valid) dose 1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 5
	when
		TargetSeries(this == $ts3doseSeries, isSeriesComplete() == false)
		not TargetSeries(this != $ts3doseSeries, seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3doseSeries);
		$ts3doseSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3doseSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts3doseSeries);
end

// Sub-bullet 2:
//   Valid for the MenB 4C 2-dose Series AND valid for MenB 4C 3-dose Series, the MenB 4C 2-dose series applies.
rule "ABSTRACT SeriesSelection(MenB): Select MenB 4C 2-Dose Series if valid dose 1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 5
	when
		exists ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Select MenB 4C Series")
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", seriesRules.seriesName == "SUPPORTED_SERIES.MenB4C2DoseSeries")
		$td : TargetDose(associatedTargetSeries == $ts, vaccineComponent.cdsConceptName in ("VACCINE_CVX_163", "VACCINE_CVX_328"))
		not TargetDose(associatedTargetSeries == $td.associatedTargetSeries, administrationDate > $td.administrationDate)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.MENINGOCOCCAL_B", vaccineComponent.cdsConceptName not in ("VACCINE_CVX_163", "VACCINE_CVX_328"), administrationDate > $td.administrationDate, isValid == true)
		eval($ts.determineNumberOfDosesAdministeredInSeries() >= 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
end

rule "SerieSelection(MenB): Select MenB 4C 2-dose series if target dose 1 (CVX 163, CVX 328) is Valid; series _is_ complete"
	extends "ABSTRACT SeriesSelection(MenB): Select MenB 4C 2-Dose Series if valid dose 1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 5
	when
		TargetSeries(this == $ts, isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($ts);
end

