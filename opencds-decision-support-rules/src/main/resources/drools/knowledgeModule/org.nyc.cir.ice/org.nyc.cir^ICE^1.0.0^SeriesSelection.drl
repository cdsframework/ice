	salience 10
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.PNEUMOCOCCAL", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.PNEUMOCOCCAL", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.PNEUMOCOCCAL", seriesRules.seriesName == "SUPPORTED_SERIES.PneumococcalAdultSeries", selectedSeries == false)
