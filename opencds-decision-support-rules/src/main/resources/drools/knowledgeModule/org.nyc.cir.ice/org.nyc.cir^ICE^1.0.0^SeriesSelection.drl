// /////// ***
// Rules for patients >= 18 years - 4 days and dose 1 is CVX 189
// /////// ***

rule "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult2DoseSeries", selectedSeries == false, $number2DoseAdultDoses : determineNumberOfDosesAdministeredInSeries())
		$td : TargetDose(associatedTargetSeries == $ts, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_189")
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", associatedTargetSeries != $ts, administrationDate < $td.administrationDate, isValid == true)
		$person : EvaluatedPerson($dtDateAtAge18yMinus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
		not TargetDose(associatedTargetSeries != $ts, isValid == true, administrationDate < $dtDateAtAge18yMinus4d)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts);
end

rule "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and < 19 years of age"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isLessThan(new TimePeriod(19, DurationType.YEARS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts);
end

rule "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and also >= 19 years of age"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isGreaterThanEqualTo(new TimePeriod(19, DurationType.YEARS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts);
end

rule "SeriesSelection(Hep B): Select Adult 2-dose Series is patient >= 18y-4d and < 19 years of age, 1 dose, and no additional shots on record"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries == 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection(Hep B): For patient with CVX 189 dose 1 administered at >= 19 years of age, and no additional shots on records, select the 3-dose Adult Series"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and also >= 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 110
	when
		TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries == 1)
		$tsAdult3Dose : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", numberOfShotsAdministeredInSeries == 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3Dose);
		$tsAdult3Dose.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsAdult3Dose.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsAdult3Dose);
end

rule "SeriesSelection(Hep B): For patient with CVX 189 dose at >= 18y-4d and < 19 years of age, and >= 1 dose and additional shots on record, select the Child/Adolescent Series if it has more doses than the Adult Series"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and < 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		$tsAdult2Dose : TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries > 1)
		$tsChildAdult : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", numberOfShotsAdministeredInSeries > 1, determineNumberOfDosesAdministeredInSeries() > $number2DoseAdultDoses)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsChildAdult);
		$tsChildAdult.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsChildAdult.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsChildAdult);
end

rule "SeriesSelection(Hep B): For patient with CVX 189 at >= 18y-4d and < 19 years of age, and >= 1 dose and additional shots on record, select the 2-dose Adult Series if it has greater than or equal the number of doses as the Child/Adolescent Series"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and < 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		$tsAdult2Dose : TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries > 1)
		$tsChildAdult : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", numberOfShotsAdministeredInSeries > 1,	determineNumberOfDosesAdministeredInSeries() <= $number2DoseAdultDoses)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult2Dose);
		$tsAdult2Dose.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsAdult2Dose.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsAdult2Dose);
end

rule "SeriesSelection(Hep B): For patient with CVX 189 dose 1 administered at >= 19 years of age, and >= 1 dose and additional shots on record, select the 3-dose Adult Series if it has more doses than the 2-dose Adult Series"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and also >= 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		$tsAdult2Dose : TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries > 1)
		$tsAdult3Dose : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", numberOfShotsAdministeredInSeries > 1, determineNumberOfDosesAdministeredInSeries() > $number2DoseAdultDoses)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3Dose);
		$tsAdult3Dose.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsAdult3Dose.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsAdult3Dose);
end

rule "SeriesSelection(Hep B): For patient with CVX 189 dose 1 administered at >= 19 years of age, and >= 1 dose and additional shots on record, select the 2-dose Adult Series if it has greater than or equal the number of doses as the Child/Adolescent Series"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and also >= 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
		$tsAdult2Dose : TargetSeries(targetSeriesIdentifier == $ts.targetSeriesIdentifier, numberOfShotsAdministeredInSeries > 1)
		$tsAdult3Dose : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", numberOfShotsAdministeredInSeries > 1, determineNumberOfDosesAdministeredInSeries() <= $number2DoseAdultDoses)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult2Dose);
		$tsAdult2Dose.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsAdult2Dose.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($tsAdult2Dose);
end

/**
 * Select the Child/Adult 3-dose series if it and it is complete - 2-dose series will be re-selected by general selection rules if
 * it completed first
 */
rule "SeriesSelection(Hep B): Select Child/Adult Series if it is complete"
	extends "ABSTRACT SeriesSelection(Hep B): (valid) Dose 1 is CVX 189 administered at >= 18y-4d and < 19 years of age"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 110
	when
		$tsChildAdult : TargetSeries(seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", isSeriesComplete() == true)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsChildAdult);
		$tsChildAdult.setSelectedSeries(true);
		$tss.setSelectedSeriesName($tsChildAdult.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS);
		update($tss);
		update($tsChildAdult);
end


// /////// ***
// Rules for Determining When to Apply the Newborn vs. Child/Adolescent Series vs. Adult 2-Dose Series vs. Adult 3-Dose Series vs.
// Hep B 3-Dose Twinrix Series vs. Hep B 4-dose Accelerated Twinrix Series (CVX 104 is Twinrix).
// /////// ***

// If the patient is >= 18 years - 4 days old and dose 1 is CVX 104.
//
// If Hep A series selection is complete, a Hep-B accelerated series is selected previously and then reverted because the corresponding
// Hep A series is not selected. In this case, a non-accelerated series should be selected.
rule "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
	  not TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_POSTPROCESS, SeriesSelectionStatus.SERIES_SELECTION_COMPLETE))
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesSelectionStatus in (SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS, SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS))
		$ts3DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB3DoseTwinrixSeries", selectedSeries == false, $number3DoseTwinrixDoses : determineNumberOfDosesAdministeredInSeries())
		$td : TargetDose(associatedTargetSeries == $ts3DoseTwinrixSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
		$person : EvaluatedPerson($dtDateAtAge18yMinus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
		eval(evalTime >= $dtDateAtAge18yMinus4d)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "ABSTRACT SeriesSelection: TargetSeries " + $ts3DoseTwinrixSeries);
end

// Rules for Hep B 4-dose Accelerated Twinrix Series (take precedence over HepB 3-dose Accelerated Twinrix Series)
//
// If dose 1 and dose 2 are CVX 104 for both Hep A 4-dose Accelerated Twinrix Series and Hep B 4-dose Accelerated Twinrix Series,
// there are two or more doses administered, dose 2 administered >= 7 days and < 24 days from dose 1 for both Hep A 4-dose Accelerated
// Twinrix Series and Hep B 4-dose Accelerated Twinrix Series, and there are no doses of Hep A that were administered prior to dose 1
// of the Hep B vaccine group, then the Hep B 4-dose Accelerated Twinrix Series applies.
//
// If dose 1 was administered at < 19 years of age:
//   - and there are 3 valid doses in the Hep B 3-dose Child/Adolescent Series, but < 4 valid doses in the Hep B 4-dose Accelerated
//     Twinrix Series, then unselect the Hep B 4-dose Accelerated Twinrix Series and select Hep B 3-dose Child/Adolescent Series.
//   - and there is a dose administered in the Hep B 3-dose Child/Adolescent Series where the administration date is after the latest
//     dose in the Hep B 4-dose Accelerated Twinrix Series, and the Hep B 3-dose Child/Adolescent Series has fewer doses remaining to
//     complete the series than the Hep B 4-dose Accelerated Twinrix Series, then select Hep B 3-dose Child/Adolescent Series.
//   - If a previously administered (Valid) dose in the Hep B 4-dose Accelerated Twinrix Series is Invalid in the Hep B 3-dose
//     Child/Adolescent Series, change the evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
//
// If dose 1 was administered >= 19 years of age:
//   - and there are 3 valid doses in the Hep B 3-dose Adult Series, but < 4 valid doses in the Hep B 4-dose Accelerated Twinrix
//     Series, then unselect the Hep B 4-dose Accelerated Twinrix Series and select Hep B 3-dose Adult Series.
//   - and there is a dose administered in the Hep B 3-dose Adult Series after the latest dose in the Hep B 4-dose Accelerated Twinrix
//     Series and the Hep B 3-dose Adult Series have fewer doses remaining to complete the series than the Hep B 4-dose Accelerated
//     Twinrix Series, then select Hep B 3-dose Adult Series.
//   - If a previously administered (Valid) dose in the Hep B 4-dose Accelerated Twinrix Series is Invalid in the Hep B 3-dose Adult
//     Series, change the evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
//
// However, if upon completion of the Hep A series selection logic, the Hep A 4-Dose Twinrix Series was not selected for the Hep A
// vaccine group, then undo the selection of this Hep B 4-dose Twinrix Series and continue with the series selection logic below to
// select a different Hep B series.

// If dose 1 and dose 2 are CVX 104 in the Hep A and Hep B 4-dose Accelerated Twinrix Series, dose 2 administered >= 7 days and < 24 days from dose 1,
// and there are no doses of Hep A or Hep B that were administered prior to dose 1 of the Hep B vaccine group.
 rule "SeriesSelection(Hep B): Select 4-dose Accelerated Twinrix Series if Hep A and Hep B doses 1 and 2 are CVX 104 are 7-24 days apart and no prior Hep A doses administered"
	extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 110
	when
	    not ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep B Twinrix Series Override Applied")
        $ts4DoseHepASeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepA4DoseAcceleratedTwinrixSeries")
	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() >= 2)
        $tdA1 : TargetDose(associatedTargetSeries == $ts4DoseHepASeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $tdA2 : TargetDose(associatedTargetSeries == $ts4DoseHepASeries, doseNumberInSeries == 2, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $tdAprev : TargetDose(associatedTargetSeries == $ts4DoseHepASeries, administeredShotNumberInSeries < $tdA2.administeredShotNumberInSeries, administrationDate < $tdA2.administrationDate, isShotIgnored() == false, $tdAprevDate : administrationDate)
        not TargetDose(associatedTargetSeries == $ts4DoseHepASeries, administrationDate > $tdAprevDate, administrationDate < $tdA2.administrationDate, isShotIgnored() == false)
        $tdB1 : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $tdB2 : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, doseNumberInSeries == 2, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $tdBprev : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, administeredShotNumberInSeries < $tdB2.administeredShotNumberInSeries, administrationDate < $tdB2.administrationDate, isShotIgnored() == false, $tdBprevDate : administrationDate)
        not TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, administrationDate > $tdBprevDate, administrationDate < $tdB2.administrationDate, isShotIgnored() == false)
	    not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", administrationDate < $tdB1.administrationDate, isValid == true)
	    not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", administrationDate < $tdB1.administrationDate, isValid == true)
	    eval(TimePeriod.calculateElapsedTimePeriod($tdAprev.administrationDate, $tdA2.administrationDate, DurationType.DAYS).isGreaterThanEqualTo(new TimePeriod(7, DurationType.DAYS)) &&
	     TimePeriod.calculateElapsedTimePeriod($tdAprev.administrationDate, $tdA2.administrationDate, DurationType.DAYS).isLessThan(new TimePeriod(24, DurationType.DAYS)) &&
	     TimePeriod.calculateElapsedTimePeriod($tdBprev.administrationDate, $tdB2.administrationDate, DurationType.DAYS).isGreaterThanEqualTo(new TimePeriod(7, DurationType.DAYS)) &&
	     TimePeriod.calculateElapsedTimePeriod($tdBprev.administrationDate, $tdB2.administrationDate, DurationType.DAYS).isLessThan(new TimePeriod(24, DurationType.DAYS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts4DoseTwinrixSeries + " (dose 1-2 7-24 days apart, 2 doses administered)");
		$ts4DoseTwinrixSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts4DoseTwinrixSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
		update($tss);
		update($ts4DoseTwinrixSeries);
end

// if dose 1 was administered at < 19 years of age and there are 3 valid doses in the Hep B 3-dose Child/Adolescent Series, but < 4 valid doses
// in the Hep B 4-dose Accelerated Twinrix Series, then unselect the Hep B 4-dose Accelerated Twinrix Series and select Hep B 3-dose Child/Adolescent Series.
 rule "SeriesSelection(Hep B): Select 3-dose Child/Adolescent Series if Hep A and Hep B doses 1 and 2 are CVX 104 and 7-24 days apart and 3 doses administered and < 19 years of age"
 	extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
	    TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
		$tsChildAdolescent : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() == 3)
		TargetSeries(targetSeriesIdentifier == $ts4DoseTwinrixSeries.targetSeriesIdentifier, numberOfShotsAdministeredInSeries < 4)
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isLessThan(new TimePeriod(19, DurationType.YEARS)))
    then
    	ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsChildAdolescent + " (override 4-dose Twinrix Series)");
    	insert(new ICEFactTypeFinding("SeriesSelection: Hep B Twinrix Series Override Applied"));
        $ts4DoseTwinrixSeries.setSelectedSeries(false);
        $tsChildAdolescent.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsChildAdolescent.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tss);
        update($ts4DoseTwinrixSeries);
        update($tsChildAdolescent);
end

// if there is a dose administered in the Hep B 3-dose Child/Adolescent Series where the administration date is after the latest dose in the Hep B 4-dose Accelerated
// Twinrix Series, and the Hep B 3-dose Child/Adolescent Series has fewer doses remaining to complete the series than the Hep B 4-dose Accelerated Twinrix Series,
// then select Hep B 3-dose Child/Adolescent Series.
 rule "SeriesSelection(Hep B): Select 3-dose Child/Adolescent Series if Hep B 3-dose Child/Adolescent Series has fewer doses remaining to complete the series than the Hep B 4-dose Accelerated Twinrix Series"
    extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 100
    when
        TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
        $latestTwinrixDose : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true)
        not TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        $tsChildAdolescent : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", selectedSeries == false)
        TargetDose(associatedTargetSeries == $tsChildAdolescent, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isLessThan(new TimePeriod(19, DurationType.YEARS)))
        eval(($tsChildAdolescent.seriesRules.numberOfDosesInSeries - $tsChildAdolescent.determineNumberOfDosesAdministeredInSeries()) < ($ts4DoseTwinrixSeries.seriesRules.numberOfDosesInSeries - $ts4DoseTwinrixSeries.determineNumberOfDosesAdministeredInSeries()))
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsChildAdolescent + " (child/adolescent has fewer doses remaining than 4-dose Twinrix, with child dose after latest Twinrix dose)");
        insert(new ICEFactTypeFinding("SeriesSelection: Hep B Twinrix Series Override Applied"));
        $ts4DoseTwinrixSeries.setSelectedSeries(false);
        $tsChildAdolescent.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsChildAdolescent.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tss);
        update($ts4DoseTwinrixSeries);
        update($tsChildAdolescent);
 end

// If a previous shot in the (previously selected) Hep B 4-dose Accelerated Twinrix Series is invalid in the Hep B 3-dose Child/Adolescent Series, change
// its evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
rule "SeriesSelection(Hep B): If a shot in the Hep B 4-dose Accelerated Twinrix Series is invalid in the Hep B 3-dose Child/Adolescent Series, mark any prior 3-dose Series doses as Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN in the 2-dose Series"
 	dialect "mvel"
 	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
 	salience 100
 	when
 	    ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep B Twinrix Series Override Applied")
 	 	$ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == false)
 		$ts4DoseTwinrixSeriesdose : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true)
 		$tdTwinrixDose1: TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
 		$tsChildAdolescent : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBChildAdolescentSeries", selectedSeries == true)
 		$tsChildAdolescentDose : TargetDose(associatedTargetSeries == $tsChildAdolescent, administrationDate == $ts4DoseTwinrixSeriesdose.administrationDate, isValid == false, status != DoseStatus.ACCEPTED)
 		$person : EvaluatedPerson($dtDateAtAge18yMinus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
        eval(evalTime >= $dtDateAtAge18yMinus4d && TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $tdTwinrixDose1.administrationDate, DurationType.YEARS).isLessThan(new TimePeriod(19, DurationType.YEARS)))
 	then
 		modify($tsChildAdolescentDose) {
 			setStatus(DoseStatus.ACCEPTED),
 			removeAllEvaluationReasonsFromAllReasonSets(),
 			addAcceptedReason("EVALUATION_REASON_CONCEPT.VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN")
 		};
 		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsChildAdolescent + ", updated dose " + $tsChildAdolescentDose);
 end

// if dose 1 was administered at >= 19 years of age and there are 3 valid doses in the Hep B 3-dose Adult Series, but < 4 valid doses
// in the Hep B 4-dose Accelerated Twinrix Series, then unselect the Hep B 4-dose Accelerated Twinrix Series and select Hep B 3-dose Adult Series.
 rule "SeriesSelection(Hep B): Select 3-dose Adult Series if Hep A and Hep B doses 1 and 2 are CVX 104 and 7-24 days apart and 3 doses administered and >= 19 years of age"
	extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
	    TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
		$tsAdult3Dose : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", selectedSeries == false, determineNumberOfDosesAdministeredInSeries() == 3)
		TargetSeries(targetSeriesIdentifier == $ts4DoseTwinrixSeries.targetSeriesIdentifier, numberOfShotsAdministeredInSeries < 4)
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isGreaterThanEqualTo(new TimePeriod(19, DurationType.YEARS)))
    then
    	ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult3Dose + " (override 4-dose Twinrix Series)");
        insert(new ICEFactTypeFinding("SeriesSelection: Hep B Twinrix Series Override Applied"));
        $ts4DoseTwinrixSeries.setSelectedSeries(false);
        $tsAdult3Dose.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsAdult3Dose.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tss);
        update($ts4DoseTwinrixSeries);
        update($tsAdult3Dose);
end

// if dose 1 was administered at >= 19 years of age and there is a dose administered in the Hep B 3-dose Adult Series after the latest dose in the Hep B 4-dose Accelerated Twinrix Series
// and the Hep B 3-dose Adult Series have fewer doses remaining to complete the series than the Hep B 4-dose Accelerated Twinrix Series, then select Hep B 3-dose Adult Series
 rule "SeriesSelection(Hep B): Select 3-dose Adult Series if Hep B 3-dose Adult Series has fewer doses remaining to complete the series than the Hep B 4-dose Accelerated Twinrix Series"
    extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
    dialect "mvel"
    ruleflow-group "SeriesSelection^customSeriesSelectionRules"
    salience 100
    when
        TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS)
 	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == true)
        $latestTwinrixDose : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true)
        not TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        $tsAdult : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", selectedSeries == false)
        TargetDose(associatedTargetSeries == $tsAdult, isValid == true, administrationDate > $latestTwinrixDose.administrationDate)
        eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isGreaterThanEqualTo(new TimePeriod(19, DurationType.YEARS)))
        eval(($tsAdult.seriesRules.numberOfDosesInSeries - $tsAdult.determineNumberOfDosesAdministeredInSeries()) < ($ts4DoseTwinrixSeries.seriesRules.numberOfDosesInSeries - $ts4DoseTwinrixSeries.determineNumberOfDosesAdministeredInSeries()))
    then
        ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult + " (adult has fewer doses remaining than 4-dose Twinrix, with adult dose after latest Twinrix dose)");
        insert(new ICEFactTypeFinding("SeriesSelection: Hep B Twinrix Series Override Applied"));
        $ts4DoseTwinrixSeries.setSelectedSeries(false);
        $tsAdult.setSelectedSeries(true);
        $tss.setSelectedSeriesName($tsAdult.seriesName);
        $tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
        update($tss);
        update($ts4DoseTwinrixSeries);
        update($tsAdult);
 end

// If a previously administered (Valid) dose in the (previously selected) Hep B 4-dose Accelerated Twinrix Series is Invalid in the Hep B 3-dose Adult Series and the 3-dose series is selected, change
// its evaluation to Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN.
rule "SeriesSelection(Hep B): If a shot in the Hep B 4-dose Accelerated Twinrix Series is invalid in the Hep B 3-dose Adult Series, mark any prior 3-dose Series doses as Accepted / VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN in the 3-dose Series"
 	dialect "mvel"
 	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
 	salience 100
 	when
 	    ICEFactTypeFinding(iceResultFinding == "SeriesSelection: Hep B Twinrix Series Override Applied")
 	    $ts4DoseTwinrixSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepB4DoseAcceleratedTwinrixSeries", selectedSeries == false)
 		$ts4DoseTwinrixSeriesDose : TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, isValid == true)
 		$tdTwinrixDose1: TargetDose(associatedTargetSeries == $ts4DoseTwinrixSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
 		$tsAdult : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", selectedSeries == true)
 		$tsAdultDose : TargetDose(associatedTargetSeries == $tsAdult, administrationDate == $ts4DoseTwinrixSeriesDose.administrationDate, isValid == false, status != DoseStatus.ACCEPTED)
 		$person : EvaluatedPerson($dtDateAtAge18yMinus4d : TimePeriod.addTimePeriod(demographics.birthTime, "18y-4d"))
 		eval(evalTime >= $dtDateAtAge18yMinus4d && TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $tdTwinrixDose1.administrationDate, DurationType.YEARS).isGreaterThanEqualTo(new TimePeriod(19, DurationType.YEARS)))
 	then
 		modify($tsAdultDose) {
 			setStatus(DoseStatus.ACCEPTED),
 			removeAllEvaluationReasonsFromAllReasonSets(),
 			addAcceptedReason("EVALUATION_REASON_CONCEPT.VACCINE_NOT_COUNTED_BASED_ON_MOST_RECENT_VACCINE_GIVEN")
 		};
 		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $tsAdult + ", updated dose " + $tsAdultDose);
 end

// Rule for Hep B 3-dose Twinrix Series when only one dose given (must be lower priority than 4-dose series)
//
// If dose 1 is CVX 104 for both Hep A and Hep B, there are no other Hep B doses on record, and the Hep B dose is in the Hep B 3-dose
// Twinrix Series, then the Hep B 3-dose Twinrix Series applies. However, if upon completion of the Hep A series selection logic,
// the Hep A 3-Dose Adult Series was not selected for the Hep A vaccine group, then undo this selection of the Hep B 3-dose
// Twinrix Series and continue with the series selection logic below to select a different Hep B series.
//
// Note: We need to check for both the first dose of Hep A 3-dose series being CVX 104 and that there is not
// another Hep A series (i.e. 2-dose) in which the first dose is not CVX 104.
rule "SeriesSelection(Hep B): Select 3-dose Twinrix Series if Hep A dose 1 is CVX 104 and no additional doses on record"
	extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 90
	when
	    not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
        $tsHepAFirstDoseSeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A")
        not TargetDose(associatedTargetSeries == $tsHepAFirstDoseSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName != "VACCINE_CVX_104")
        $ts3DoseHepASeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries")
        TargetDose(associatedTargetSeries == $ts3DoseHepASeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $td : TargetDose(associatedTargetSeries == $ts3DoseTwinrixSeries, doseNumberInSeries == 1, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", isValid == true, administrationDate != $td.administrationDate)
		TargetSeries(targetSeriesIdentifier == $ts3DoseTwinrixSeries.targetSeriesIdentifier, determineNumberOfDosesAdministeredInSeries() == 1)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3DoseTwinrixSeries + " (1 dose of CVX 104 on record)");
		$ts3DoseTwinrixSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3DoseTwinrixSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
		update($tss);
		update($ts3DoseTwinrixSeries);
end

// If dose 1 and dose 2 are CVX 104 for both Hep A and Hep B, dose 2 administered >= 24 days from dose 1, and the Hep B doses are in
// the Hep B 3-dose Twinrix Series and Hep A 3-dose Adult Series, then the Hep B 3-dose Twinrix Series applies. Furthermore, if a 3rd dose was administered in
// the Hep B 3-dose Twinrix Series, then the Hep B 3-dose Twinrix Series applies.
rule "SeriesSelection(Hep B): Select 3-dose Twinrix Series if Hep A and Hep B doses 1 and 2 are CVX 104 and 24+ days apart"
	extends "ABSTRACT SeriesSelection(Hep B): Dose 1 is CVX 104 and patient >= 18y-4d"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	when
	    not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", selectedSeries == true)
	    not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesName != "SUPPORTED_SERIES.HepB3DoseTwinrixSeries", isSeriesComplete() == true)
		TargetSeries(targetSeriesIdentifier == $ts3DoseTwinrixSeries.targetSeriesIdentifier, numberOfShotsAdministeredInSeries >= 2)
		not TargetDose(associatedTargetSeries.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", isValid == true, administrationDate < $td.administrationDate)
		not TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", targetSeriesIdentifier != $ts3DoseTwinrixSeries.targetSeriesIdentifier, isSeriesComplete() == true)
        $td2 : TargetDose(associatedTargetSeries == $ts3DoseTwinrixSeries, doseNumberInSeries == 2, isValid == true, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $ts3DoseHepASeries : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_A", seriesName == "SUPPORTED_SERIES.HepAAdult3DoseSeries")
        $tdA1 : TargetDose(associatedTargetSeries == $ts3DoseHepASeries, doseNumberInSeries == 1, isValid == true, administrationDate == $td.administrationDate, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        $tdA2 :TargetDose(associatedTargetSeries == $ts3DoseHepASeries, doseNumberInSeries == 2, isValid == true, administrationDate == $td2.administrationDate, administeredVaccine.cdsConceptName == "VACCINE_CVX_104")
        eval(TimePeriod.calculateElapsedTimePeriod($td.administrationDate, $td2.administrationDate, DurationType.DAYS).isGreaterThanEqualTo(new TimePeriod(24, DurationType.DAYS)))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts3DoseTwinrixSeries + " (2 doses 24+ days apart)");
		$ts3DoseTwinrixSeries.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts3DoseTwinrixSeries.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_PENDING_OTHERS);
		update($tss);
		update($ts3DoseTwinrixSeries);
end


// /////// ***
// Start DTP series selection rules
// /////// ***

// If the patient is >= 7 years of age and has zero doses on record prior to age 7 years, then the 3-dose series applies; otherwise
// the 5-dose series applies.
rule "SeriesSelection.SelectDTP5DoseSeriesIf3DoseSeriesNotSelected"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 100
	activation-group "DTPSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", selectedSeries == true))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", seriesRules.seriesName == "SUPPORTED_SERIES.DTP5DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

rule "SeriesSelection.Select3DoseDTPSeriesIfNoShotsPriorTo7YrsAnd7YrsOldOrOlder"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 110
	activation-group "DTPSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", selectedSeries == true))
		$person : EvaluatedPerson($birthDate : demographics.birthTime, $ageAt7yrs : TimePeriod.addTimePeriod(demographics.birthTime, "7y"))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.DTP", seriesRules.seriesName == "SUPPORTED_SERIES.DTP3DoseSeries")
		not TargetDose(associatedTargetSeries == $ts, administrationDate < $ageAt7yrs)
		eval(TimePeriod.calculateElapsedTimePeriod($birthDate, evalTime, DurationType.YEARS).isGreaterThan(new TimePeriod(7, DurationType.YEARS), true))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

