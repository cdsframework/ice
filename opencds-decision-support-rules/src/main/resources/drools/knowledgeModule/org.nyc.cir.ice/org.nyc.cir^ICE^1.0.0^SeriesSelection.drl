/**
 * If no doses have been administered, then select the Rotavirus 3-dose series
 */
rule "SeriesSelection.SelectRotavirus3DoseSeriesDefault"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 140
	activation-group "RotavirusSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", selectedSeries == true))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesRules.seriesName == "SUPPORTED_SERIES.Rotavirus3DoseSeries")
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		update($ts);
end

/**
 * If CVX 116 (Rotavirus RV5 (RotaTeq, 3 dose)), CVX 74 (Rotavirus) or CVX 122 (Rotavirus NOS) is administered, then the 3 dose
 * series applies.
 */
rule "SeriesSelection.SelectRotavirus3DoseSeriesIfCertainVaccinesAdministered"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 200
	activation-group "RotavirusSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", selectedSeries == true))
		$td : TargetDose(isValid == true, isShotIgnored() == false,
			(vaccineComponent.cdsConceptName == "VACCINE_CVX_116" ||
			  vaccineComponent.cdsConceptName == "VACCINE_CVX_122" ||
			  vaccineComponent.cdsConceptName == "VACCINE_CVX_74"))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesRules.seriesName == "SUPPORTED_SERIES.Rotavirus3DoseSeries", containsTargetDose($td))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		update($ts);
end

/**
 * If dose 1 is CVX 119 (Rotavirus RV1 (Rotarix, 2 dose)) then the 2 dose series applies
 */
rule "SeriesSelection.SelectRotavirus2DoseSeriesIf1DoseRV1"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 150
	activation-group "RotavirusSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", selectedSeries == true))
		$td : TargetDose(isValid == true, doseNumberInSeries == 1, vaccineComponent.cdsConceptName == "VACCINE_CVX_119")
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.ROTAVIRUS", seriesRules.seriesName == "SUPPORTED_SERIES.Rotavirus2DoseSeries", containsTargetDose($td))
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: TargetSeries " + $ts);
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		update($ts);
end

function List getAllDosesAcrossListOfTargetSeries(List tss) {
	List tds = new ArrayList();
	if (tss == null) {
		return tds;
	}

	Iterator iter = tss.iterator();
	while (iter.hasNext()) {
		TargetSeries ts = (TargetSeries) iter.next();
		Collection tsd = ts.getTargetDoses();
		if (tsd != null) {
			Iterator ii = tsd.iterator();
			while (ii.hasNext()) {
				TargetDose td = (TargetDose) ii.next();
				tds.add(td);
			}
		}
	}

	return tds;
}