rule "SeriesSelection.JapaneseEncephalitis.SelectJEVCRisk2DoseSeriesIfPatientUnder18OrOver65YearsAtFirstDose"
	dialect "mvel"
	ruleflow-group "SeriesSelection^customSeriesSelectionRules"
	salience 120
	activation-group "JapaneseEncephalitisSeriesSelectionCheck"
	when
		$tss : TargetSeriesSelection(seriesSelectionVaccineGroup == "VACCINE_GROUP_CONCEPT.JAPANESE_ENCEPHALITIS", seriesSelectionStatus == SeriesSelectionStatus.SERIES_SELECTION_IN_PROCESS)
		not (exists TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.JAPANESE_ENCEPHALITIS", selectedSeries == true))
		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.JAPANESE_ENCEPHALITIS", seriesRules.seriesName == "SUPPORTED_SERIES.JEVCRisk2DoseSeries")
		$td : TargetDose(associatedTargetSeries == $ts, doseNumberInSeries == 1, isValid == true, $administrationDate : administrationDate)
		$person : EvaluatedPerson()
		$dtBirthDate : Date() from $person.demographics.birthTime
		eval(TimePeriod.compareElapsedTimePeriodToDateRange($person.demographics.birthTime, $administrationDate, "18y-4d") < 0 ||
		     TimePeriod.compareElapsedTimePeriodToDateRange($person.demographics.birthTime, $administrationDate, "66y") >= 0)
	then
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "SeriesSelection: Patient was outside 18 to 65 years at first dose, selecting JE-VC Risk 2-dose Series");
		$ts.setSelectedSeries(true);
		$tss.setSelectedSeriesName($ts.seriesName);
		$tss.setSeriesSelectionStatus(SeriesSelectionStatus.SERIES_SELECTION_COMPLETE);
		update($tss);
		update($ts);
end

