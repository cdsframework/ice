		$ts : TargetSeries(seriesRules.vaccineGroup == "VACCINE_GROUP_CONCEPT.HEP_B", seriesRules.seriesName == "SUPPORTED_SERIES.HepBAdult3DoseSeries", selectedSeries == false, containsTargetDose($td))
		$person : EvaluatedPerson()
		eval(TimePeriod.calculateElapsedTimePeriod($person.demographics.birthTime, $td.administrationDate, DurationType.YEARS).isGreaterThanEqualTo(new TimePeriod(19, DurationType.YEARS)))
