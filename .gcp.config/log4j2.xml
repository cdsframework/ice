<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c{1} - %msg%n"/>
        </Console>
        <Console name="brief-console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%-5level] %c{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info" additivity="false">
            <AppenderRef ref="console"/>
        </Root>
        <Logger name="org.drools.mvel.MVELConstraint" level="error" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="drools-events" level="info" additivity="false">
            <AppenderRef ref="brief-console"/>
        </Logger>
        <Logger name="org.cdsframework.ice.service.ICELogicHelper" level="info" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
    </Loggers>
</Configuration>
