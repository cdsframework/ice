package knowledgeModule.gov.nyc.cir.ice;

import org.opencds.vmr.v1_0.internal.EvalTime;
import org.opencds.vmr.v1_0.internal.EvaluatedPerson;
import org.cdsframework.ice.service.DoseStatus;
import org.cdsframework.ice.service.ICELogicHelper;
import org.cdsframework.ice.service.Schedule;
import org.cdsframework.ice.util.TimePeriod;
import org.cdsframework.ice.util.TimePeriod.DurationType;
import org.cdsframework.ice.service.RecommendationStatus;
import org.cdsframework.ice.service.SeriesRules;
import org.cdsframework.ice.service.TargetDose;
import org.cdsframework.ice.service.TargetSeries;
import org.cdsframework.ice.util.TimePeriod;
import org.cdsframework.ice.service.Vaccine;

expander ../../knowledgeCommon/org.cdsframework.ice/org.cdsframework^ICE^1.0.0.dsl;

global java.util.Date evalTime;

rule "Hep A: If a shot administered was evaluated and Not Valid due to ABOVE_MAXIMUM_AGE_VACCINE, ignore the shot when calculating intervals"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $administeredShot
			- the shot belongs to the vaccine group "VACCINE_GROUP_CONCEPT.810"
			- that has already been evaluated and whose Shot Validity Status is not VALID
			- the shot is not ignored
			- make note of all evaluation reasons for this shot as $collectionOfStrReasons
			- the collection $collectionOfStrReasons contains "EVALUATION_REASON_CONCEPT.ABOVE_MAXIMUM_AGE_VACCINE"
			- make note of the Associated Series as $associatedTargetSeries
	then
		Mark the shot $administeredShot as Ignored
		Refresh all facts for the shot $administeredShot
		Record that this dose rule was Processed for the TargetDose $administeredShot
		Log that this dose rule fired for the dose $administeredShot in the Series $associatedTargetSeries
end

rule "Hep A: Evaluate shot 2 as Valid if administered >= 6 months-4 days from Dose 1 in the 2-dose Series, even if there have been invalid shots administered"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "doseIntervalCheck"
	when
		There is an Administered Shot $currentDose that needs to be evaluated
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.810" and the Series with Name "HepA2DoseChildAdultSeries"
			- the dose number in the series is == 2
			- make note of the date this shot was administered as $dtAdministrationDateCurrentDose
			- make note of the Associated Series as $associatedTargetSeries
		There is an Administered Shot $previousDose
			- the shot belongs to the Series $associatedTargetSeries
			- the dose number in the series is == 1
			- that has already been evaluated and whose shot validity is VALID
			- make note of the date this shot was administered as $dtAdministrationDatePreviousDose
		Confirm Elapsed time between $dtAdministrationDatePreviousDose and $dtAdministrationDateCurrentDose >= "6m-4d"
	then
		Record that this dose rule was Processed for the TargetDose $currentDose
		Log that this dose rule fired for the dose $currentDose in the Series $associatedTargetSeries
end

rule "Hep A: If CVX 104 (Twinrix) is administered at >= 18 years-4 days in the 3-dose Series, there is no maximum age for the Hep A vaccine component (CVX 83)"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	activation-group "maximumAgeVaccineCheck"
	when
		There is an administered shot $currentShot that needs to be evaluated
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.810" and the Series with name "HepAAdult3DoseSeries"
			- make note of the date this shot was administered as $administrationDate
			- make note of the associated series as $associatedTargetSeries
			- the vaccine administered is "ICE104"
		The patient information $oEvaluatedPerson must be known to complete writing this rule
			- make note of the patient's birthdate as $dtBirthDate
		Confirm Elapsed time between $dtBirthDate and $administrationDate >= "18y-4d"
	then
		Record that this dose rule was Processed for the TargetDose $currentShot
		Log that this dose rule fired for the dose $currentShot in the Series $associatedTargetSeries
end

rule "Hep A: If dose 1 and dose 2 are administered in the 3-dose Series at < 19y of age, and the interval between dose 1 and dose 2 is >= 6 months-4 day, then the Series is complete"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^postEvaluationCheck"
	when
		There is an administered shot $hepAAdultDose2
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.810" and the Series with name "HepAAdult3DoseSeries"
			- the dose number in the Series is == 2
			- that has already been evaluated and whose shot validity is VALID
			- make note of the date this shot was administered as $administrationDateDose2
			- make note of the associated series as $associatedTargetSeries
		There is an administered shot $hepAAdultDose1
			- the shot belongs to the Series $associatedTargetSeries
			- the dose number in the Series is == 1
			- that has already been evaluated and whose shot validity is VALID
			- make note of the date this shot was administered as $administrationDateDose1
		The patient information $patientInformation must be known to complete writing this rule
			- make note of the patient's birthdate as $dtBirthDate
		Confirm elapsed time between $dtBirthDate and $administrationDateDose2 < "19y" && elapsed time between $administrationDateDose1 and $administrationDateDose2 >= "6m-4d"
	then
		Mark the Series $associatedTargetSeries complete
		Record that this dose rule was Processed for the TargetDose $hepAAdultDose2
		Log that this dose rule fired for the dose $hepAAdultDose2 in the Series $associatedTargetSeries
end

rule "Hep A: Switch from 2-Dose Hep A series to 3-Dose Hep A series if CVX 104 dose is administered to a patient >= 18 year-4 days as dose 2 and a previous dose was administered prior to 18 years-4 days"
	dialect "mvel"
	ruleflow-group "HistoryEvaluation^customEvaluationRule"
	when
		There is an administered shot $latestShot that needs to be evaluated
			- the shot belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.810" and the Series with name "HepA2DoseChildAdultSeries"
			- the dose number in the series is == 2
			- the vaccine administered is "ICE104"
			- make note of the Administered Shot Number as $assign_nAdministeredShotNumber
			- make note of the associated series as $targetSeries
		The Patient information $assign_oEvaluatedPerson must be known to complete writing this rule
			- make note of the Patient's birthdate as $dtBirthDate
			- make note of the date as $dtDateAtAge18yMinus4d when the patient is "18y-4d" of age
		There is an administered shot $sameShot
			- that is the same shot as $latestShot
			- the administration date of the shot is >= $dtDateAtAge18yMinus4d
		There is an administered shot $dose1evaluatedValid
			- the shot belongs to the Series $targetSeries
			- the dose number in the Series is == 1
			- that has already been evaluated and whose Shot Validity is VALID
			- the administration date of the shot is < $dtDateAtAge18yMinus4d
		There is a Series $seriesToSwitchTo
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.810"
			- the name of the Series is "HepAAdult3DoseSeries"
	then
		Convert from Series $targetSeries to $seriesToSwitchTo starting with Dose Number 2 and evaluate using Interval for prior dose to this dose from SwitchedTo Series
		Refresh all facts in the Series $targetSeries for Evaluation
		Refresh all facts for the Shot $latestShot
		Log that this Series Rule fired for the Series $targetSeries
end
