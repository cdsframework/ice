/**
 * Recommended interval between Dose 1 and Dose 3 in Men B FHbp 3-dose series is 6 months
 */
rule "MeningB: Recommend minimum interval & recommended interval of at 6 months between doses 1 & 3 in FHbp 3-dose Series"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	when
		There is a Series $targetSeries that needs Forecasting
			- the name of the Series is "MenBFHbp3DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the effective dose number in the Series is == 3
		There is an Administered Shot $dose1
			- the Shot belongs to the Series $targetSeries
			- the Dose Number in the Series is == 1
			- that has already been Evaluated and whose Shot Validity is VALID
			- Make note of the Date this Shot was Administered as $dtAdministrationDate
	then
		Add "6m" to $dtAdministrationDate and make note of the newly calculated date as $dtCalculated
		Include a Recommendation as $r with Recommended Forecast Date $dtCalculated for consideration in the final Forecast of the Series $targetSeries
		Set the Recommendation Earliest Forecast Date for $r to $dtCalculated
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

/**
 * Recommended interval between Dose 1 and Dose 3 in Men B 4C 3-dose series is 6 months
 */
rule "MenB(4C 3-Dose Series): Recommend minimum & recommended interval of at 6 months between doses 1 & 3"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	when
		There is a Series $targetSeries that needs forecasting
			- the name of the Series is "MenB4C3DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the effective dose number in the Series is == 3
		There is an Administered Shot $dose1
			- the Shot belongs to the Series $targetSeries
			- the Dose Number in the Series is == 1
			- that has already been Evaluated and whose Shot Validity is VALID
			- Make note of the Date this Shot was Administered as $dtAdministrationDate
	then
		Add "6m" to $dtAdministrationDate and make note of the newly calculated date as $dtCalculated
		Include a Recommendation as $r with Recommended Forecast Date $dtCalculated for consideration in the final Forecast of the Series $targetSeries
		Set the Recommendation Earliest Forecast Date for $r to $dtCalculated
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

rule "MenB(4C 2-Dose Series): If (valid) dose 1 was >= 10/25/2024, the minimum interval & recommended interval is 6m from the (valid) dose 1 (*recommendationIntervalCheck*)"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	when
		There is a Series $targetSeries that needs forecasting
			- the name of the Series is "MenB4C2DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the effective dose number in the Series is == 2
		 There is an Administered Shot $dose1
			- the Shot belongs to the Series $targetSeries
			- the Dose Number in the Series is == 1
			- that has already been Evaluated and whose Shot Validity is VALID
			- the administration date of the shot is >= "25-Oct-2024"
			- Make note of the Date this Shot was Administered as $dtAdministrationDate
	then
		Add "6m" to $dtAdministrationDate and make note of the newly calculated date as $dtCalculated
		Create a recommendation as $r for the Series $targetSeries
		Set the recommendation recommended forecast date for $r to the latter of $dtCalculated and "25-Oct-2024"
		Set the recommendation earliest forecast date for $r to the latter of $dtCalculated and "25-Oct-2024"
		Include the Recommendation $r for Consideration in the final forecast of the Series
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

rule "MenB(4C 2-Dose Series): If the (valid) dose 1 was administered >= 10/25/2024, the minimum interval & recommended interval is 6m from the (valid) dose 1 (*earliestIntervalCheck*)"
		extends "MenB(4C 2-Dose Series): If (valid) dose 1 was >= 10/25/2024, the minimum interval & recommended interval is 6m from the (valid) dose 1 (*recommendationIntervalCheck*)"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	when
	then
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

rule "MenB(4C 2-Dose Series; Target Dose 1; CRR): If no shots were administered and the evalTime < 10/25/2024, modify DoseRule1 as follows: (1) set the minimum age and recommended age to 10 years; (2) set the minimum interval and recommended interval from dose 1 to dose 2 to 1 month"
	dialect "mvel"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	no-loop true
	salience 999
	when
		There is a Series $targetSeries that needs forecasting
			- the name of the Series is "MenB4C2DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the number of administered shots is == 0
		Confirm the date evalTime is before "25-Oct-2024"
	then
		Obtain the existing DoseRule for Dose Number 1 in the Series $targetSeries as $assign_oDoseRule1
		Set the Minimum Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Recommended Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Minimum Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Set the Recommended Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Replace the existing DoseRule in the Series $targetSeries with $assign_oDoseRule1
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

rule "MenB(4C 2-Dose Series; Target Dose 1; CRR): If an (invalid) shot was 1 was administered < 10/25/2024, modify DoseRule1 as follows: (1) set the minimum age and recommended age to 10 years; (2) set the minimum interval and recommended interval from dose 1 to dose 2 to 1 month"
	dialect "mvel"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	no-loop true
	salience 999
	when
		There is a Series $targetSeries that needs forecasting
			- the name of the Series is "MenB4C2DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the number of doses administered is == 0
		There exists an administered shot
			- the shot belongs to the Series $targetSeries
			- the administration date of the shot is < "25-Oct-2024"
		There does not exist an administered shot
			- the shot belongs to the Series $targetSeries
			- the administration date of the shot is >= "25-Oct-2024"
	then
		Obtain the existing DoseRule for Dose Number 1 in the Series $targetSeries as $assign_oDoseRule1
		Set the Minimum Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Recommended Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Minimum Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Set the Recommended Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Replace the existing DoseRule in the Series $targetSeries with $assign_oDoseRule1
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end

rule "MenB(4C 2-Dose Series; Target Dose 2; CRR): If a (valid) dose 1 administered was < 10/25/2024, modify DoseRule1 as follows: (1) set the minimum age and recommended age to 10 years; (2) set the minimum interval and recommended interval from dose 1 to dose 2 to 1 month"
	dialect "mvel"
	ruleflow-group "RecommendationForecast^customRecommendationRule"
	no-loop true
	salience 999
	when
		There is a Series $targetSeries that needs forecasting
			- the name of the Series is "MenB4C2DoseSeries"
			- the Series belongs to the Vaccine Group "VACCINE_GROUP_CONCEPT.835"
			- the Series is not Complete
			- the number of doses administered is == 1
		There exists an administered shot
			- the shot belongs to the Series $targetSeries
			- that has already been evaluated and whose shot validity is VALID
			- the dose number in the Series is == 1
			- the administration date of the shot is < "25-Oct-2024"
	then
		Obtain the existing DoseRule for Dose Number 2 in the Series $targetSeries as $assign_oDoseRule2
		Set the Minimum Age for DoseRule $assign_oDoseRule2 to TimePeriod "10y+1m"
		Set the Recommended Age for DoseRule $assign_oDoseRule2 to TimePeriod "10y+1m"
		Replace the existing DoseRule in the Series $targetSeries with $assign_oDoseRule2
		Obtain the existing DoseRule for Dose Number 1 in the Series $targetSeries as $assign_oDoseRule1

		Set the Minimum Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Recommended Age for DoseRule $assign_oDoseRule1 to TimePeriod "10y"
		Set the Minimum Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Set the Recommended Interval for DoseRule $assign_oDoseRule1 to TimePeriod "1m"
		Replace the existing DoseRule in the Series $targetSeries with $assign_oDoseRule1
		Record that this Series Rule was Processed for the TargetSeries $targetSeries
		Log that this Series Rule fired for the Series $targetSeries
end