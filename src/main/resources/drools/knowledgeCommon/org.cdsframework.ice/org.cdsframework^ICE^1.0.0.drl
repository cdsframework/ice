rule "RecommendationForecast.finalizeRecommendationsForSeries"
	ruleflow-group "RecommendationForecast"
	dialect "mvel"
	when
		$ts : TargetSeries(recommendationStatus == RecommendationStatus.FORECASTING_COMPLETE)
		not Recommendation(targetSeriesIdentifier == $ts.targetSeriesIdentifier)
	then
		$ts.finalizeRecommendationsForForecasting();
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Finalized recommendations for TargetSeries " + $ts.getSeriesName());

		update($ts);
		drools.setFocus("RecommendationForecast^supplementalSeriesRule");
		drools.setFocus("RecommendationForecast^adjustRecommendationDates");
end

rule "RecommendationForecast.addAnyRecommendationsOnFactListToSeries"
	ruleflow-group "RecommendationForecast"
	dialect "mvel"
	when
		$ts : TargetSeries(recommendationStatus == RecommendationStatus.FORECASTING_COMPLETE)
		$recommendation : Recommendation(targetSeriesIdentifier == $ts.targetSeriesIdentifier)
	then
		$ts.addInterimRecommendationForConsideration($recommendation, evalTime);
		retract($recommendation);
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Finalized recommendations for TargetSeries " + $ts.getSeriesName());
		update($ts);
end

rule "RecommendationForecast.allRecommendationRulesProcessedForSeries"
	ruleflow-group "RecommendationForecast"
	dialect "mvel"
	salience 95
	when
		$ts : TargetSeries(recommendationStatus == RecommendationStatus.FORECASTING_IN_PROGRESS)
	then
		modify($ts) {
			setRecommendationStatus(RecommendationStatus.FORECASTING_COMPLETE)
		};
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetSeries " + $ts.seriesName);
end

rule "RecommendationForecast.recommendBasedOnEarliestAgeRule"
	ruleflow-group "RecommendationForecast"
	dialect "mvel"
	salience 100
	activation-group "earliestAgeCheck"
	when

		$evalTime : EvalTime()
		$ts : TargetSeries(recommendationStatus == RecommendationStatus.FORECASTING_IN_PROGRESS)
		$person : EvaluatedPerson()
	then
		$ts.recommendNextShotBasedOnEarliestAgeRule($person.demographics.birthTime, $evalTime.getEvalTimeValue());
		$ts.addSeriesRuleProcessed(drools.getRule().getName());
		ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "TargetSeries " + $ts.seriesName);
end

rule "RecommendationForecast.recommendBasedOnEarliestIntervalRule"
