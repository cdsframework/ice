		recommendation.setRecommendationDate(ICELogicHelper.toDate($ts.getTargetSeason().getFullySpecifiedSeasonOffSeasonEndDate().plusDays(1)));
		$ts.addInterimRecommendationForConsideration(recommendation, evalTime);
