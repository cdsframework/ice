		};
      	ICELogicHelper.logDRLDebugMessage(drools.getRule().getName(), "Earliest date adjustment from " + $earliestDate + " to " + $lvd.liveVirusDate + " due to live virus vaccine administered on : " + $lvd.liveVirusDate + " in TargetSeries " + $targetSeries.getSeriesName());
end

