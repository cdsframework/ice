<?xml version="1.0" encoding="UTF-8"?>
<bindings xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
          xmlns="https://jakarta.ee/xml/ns/jaxb"
          version="3.0">

    <globalBindings typesafeEnumMaxMembers="2000">
        <xjc:simple/>
    </globalBindings>

    <bindings schemaLocation="xml.xsd" node="/xs:schema">
        <schemaBindings>
            <package name="org.w3.xml"/>
        </schemaBindings>
        <bindings node=".//xs:attribute[@name='lang']">
            <property name="xmlLang"/>
        </bindings>
    </bindings>
    <bindings schemaLocation="codesystem.xsd" node="/xs:schema">
        <!-- Resource-level property: CodeSystem.Property -->
        <bindings node="xs:complexType[@name='CodeSystem.Property']">
            <class name="CodeSystemResourceProperty"/>
        </bindings>
        <!-- Concept-level property: CodeSystem.Property1 -->
        <bindings node="xs:complexType[@name='CodeSystem.Property1']">
            <class name="CodeSystemConceptProperty"/>
        </bindings>
    </bindings>
</bindings>