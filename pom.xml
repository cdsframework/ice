    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>ice.properties</include>
                    <include>log4j2.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/org/cdsframework/ice/util/git.properties
                    </generateGitPropertiesFilename>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${jaxb-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaDirectory>${basedir}/src/main/resources/client</schemaDirectory>
                            <schemaIncludes>
                                <include>BPMN20.xsd</include>
                                <include>codeSystem.xsd</include>
                                <include>code.xsd</include>
                                <include>conceptType.xsd</include>
                                <include>supportedConceptType.xsd</include>
                                <include>conceptMapping.xsd</include>
                                <include>adapter-client.xsd</include>
                            </schemaIncludes>
                            <bindingIncludes>
                                <include>bindings-client.xjb.xml</include>
                            </bindingIncludes>
                            <generateDirectory>${project.build.directory}/generated-sources/client</generateDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jaxb-generate-cdsframework</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <args>
                                <arg>-extension</arg>
                            </args>
                            <schemaDirectory>${basedir}/src/main/resources/xml</schemaDirectory>
                            <schemaIncludes>
                                <include>*.xsd</include>
                            </schemaIncludes>
                            <bindingIncludes>
                                <include>*.xjb.xml</include>
                            </bindingIncludes>
                            <generateDirectory>${project.build.directory}/generated-sources/xml</generateDirectory>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <extension>true</extension>
                    <verbose>true</verbose>
                    <markGenerated>true</markGenerated>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>${jaxws-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>wsimport-generate-evaluate</id>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlDirectory>${basedir}/src/main/resources/client</wsdlDirectory>
                            <wsdlFiles>
                                <wsdlFile>evaluate.wsdl</wsdlFile>
                            </wsdlFiles>
                            <bindingDirectory>${basedir}/src/main/resources/client</bindingDirectory>
                            <bindingFiles>
                                <bindingFile>bindings-ws.xjb.xml</bindingFile>
                                <bindingFile>adapter-ws.xsd</bindingFile>
                            </bindingFiles>
                            <wsdlLocation>https://cds.hln.com/opencds-decision-support-service/evaluate?wsdl</wsdlLocation>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <xnocompile>true</xnocompile>
                    <verbose>true</verbose>
                    <extension>true</extension>
                    <xjcArgs>
                        <xjcArg>-mark-generated</xjcArg>
                    </xjcArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
